{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "config": {
    "font": "IBM Plex Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "gridColor": "#DFE6EE",
      "domain": false,
      "tickColor": "#B3C2D3",
      "labelColor": "#4E6078",
      "titleColor": "#162B4D",
      "titlePadding": 14,
      "labelLimit": 150,
      "labelPadding": 7,
      "labelOverlap": true
    },
    "legend": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "orient": "bottom",
      "title": null,
      "labelLimit": 240
    },
    "title": {
      "fontSize": 16,
      "anchor": "start",
      "color": "#162B4D",
      "lineHeight": 20
    },
    "text": {
      "fontSize": 16,
      "lineHeight": 20,
      "color": "#162B4D"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/flows.json"
      },
      "mark": {
        "type": "area",
        "color": "#2457D6"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              -0.03,
              1.03
            ]
          }
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              5.05,
              -0.25
            ]
          }
        },
        "y2": {
          "field": "y2"
        },
        "detail": {
          "field": "link"
        },
        "opacity": {
          "condition": {
            "test": "datum.destination == 'In Australia'",
            "value": 0.8
          },
          "value": 0.35
        },
        "tooltip": [
          {
            "field": "destination",
            "title": "Spending location"
          },
          {
            "field": "value",
            "type": "quantitative",
            "format": "$,.0f",
            "title": "AUD"
          },
          {
            "field": "share",
            "type": "quantitative",
            "format": ".1%",
            "title": "Share of international total trip spending"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/flow-nodes.json"
      },
      "mark": {
        "type": "rule",
        "strokeWidth": 6,
        "color": "#162B4D"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              -0.03,
              1.03
            ]
          }
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              5.05,
              -0.25
            ]
          }
        },
        "y2": {
          "field": "y2"
        }
      }
    },
    {
      "data": {
        "url": "data/flow-nodes.json"
      },
      "transform": [
        {
          "filter": "datum.x == 0"
        },
        {
          "calculate": "(datum.y + datum.y2)/2",
          "as": "mid"
        },
        {
          "calculate": "'International\\ntrip spending\\nAUD ' + format(datum.value/1e9,'.2f') + 'bn'",
          "as": "direct_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 15,
        "fontWeight": "bold",
        "color": "#07101C",
        "lineBreak": "\n",
        "lineHeight": 20,
        "baseline": "middle"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "mid",
          "type": "quantitative"
        },
        "text": {
          "field": "direct_label"
        }
      }
    },
    {
      "data": {
        "url": "data/flow-nodes.json"
      },
      "transform": [
        {
          "filter": "datum.x == 1"
        },
        {
          "calculate": "(datum.y + datum.y2)/2",
          "as": "mid"
        },
        {
          "calculate": "(datum.label == 'In Australia' ? 'In Australia' : 'Overseas') + '\\nAUD ' + format(datum.value/1e9,'.2f') + 'bn\\n' + format(datum.share,'.1%')",
          "as": "direct_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -10,
        "fontSize": 15,
        "fontWeight": "bold",
        "color": "#07101C",
        "lineBreak": "\n",
        "lineHeight": 20,
        "baseline": "middle"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "mid",
          "type": "quantitative"
        },
        "text": {
          "field": "direct_label"
        }
      }
    }
  ]
}
