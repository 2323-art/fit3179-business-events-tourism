{
  "width": "container",
  "height": 420,
  "config": {
    "font": "IBM Plex Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "gridColor": "#DFE6EE",
      "domain": false,
      "tickColor": "#B3C2D3",
      "labelColor": "#4E6078",
      "titleColor": "#162B4D",
      "titlePadding": 14,
      "labelLimit": 150,
      "labelPadding": 7,
      "labelOverlap": true
    },
    "legend": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "orient": "bottom",
      "title": null,
      "labelLimit": 240
    },
    "title": {
      "fontSize": 16,
      "anchor": "start",
      "color": "#162B4D",
      "lineHeight": 20
    },
    "text": {
      "fontSize": 16,
      "lineHeight": 20,
      "color": "#162B4D"
    }
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "layer": [
    {
      "data": {
        "url": "data/flows.json"
      },
      "mark": {
        "type": "area",
        "opacity": 0.8
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              -0.03,
              1.03
            ]
          }
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              21,
              0
            ]
          }
        },
        "y2": {
          "field": "y2"
        },
        "detail": {
          "field": "link",
          "type": "nominal"
        },
        "color": {
          "field": "traveller",
          "type": "nominal",
          "scale": {
            "domain": [
              "Domestic day",
              "Domestic overnight",
              "International"
            ],
            "range": [
              "#B47716",
              "#007F78",
              "#2457D6"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "link",
            "type": "nominal",
            "title": "Flow"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Australian dollars",
            "format": "$,.0f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/flow-nodes.json"
      },
      "mark": {
        "type": "rule",
        "strokeWidth": 7,
        "color": "#162B4D"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "y2": {
          "field": "y2"
        }
      }
    },
    {
      "data": {
        "url": "data/flow-nodes.json"
      },
      "transform": [
        {
          "filter": "datum.x == 1"
        },
        {
          "calculate": "(datum.y + datum.y2)/2",
          "as": "mid"
        },
        {
          "calculate": "(datum.label == 'Domestic overnight' ? 'Domestic\\novernight' : datum.label == 'Outside Australia' ? 'Overseas' : datum.label) + '\\n' + format(datum.value/1e9,'.2f') + ' billion'",
          "as": "direct_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -10,
        "color": "#07101C",
        "fontWeight": "bold",
        "fontSize": 16,
        "lineBreak": "\n",
        "lineHeight": 20,
        "baseline": "middle",
        "dy": -7
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "mid",
          "type": "quantitative"
        },
        "text": {
          "field": "direct_label",
          "type": "nominal"
        }
      }
    }
  ]
}