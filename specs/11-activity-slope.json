{
  "width": "container",
  "height": 320,
  "config": {
    "font": "IBM Plex Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "gridColor": "#DFE6EE",
      "domain": false,
      "tickColor": "#B3C2D3",
      "labelColor": "#162B4D",
      "titleColor": "#162B4D",
      "titlePadding": 12,
      "labelLimit": 150
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "orient": "bottom",
      "title": null
    },
    "title": {
      "fontSize": 14,
      "anchor": "start",
      "color": "#162B4D"
    }
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/activities.json"
  },
  "transform": [
    {
      "filter": "datum.activity != 'Go shopping'"
    },
    {
      "calculate": "datum.year == 2024 ? 0.06 : 0.53",
      "as": "position"
    }
  ],
  "encoding": {
    "x": {
      "field": "position",
      "type": "quantitative",
      "axis": null,
      "scale": {
        "domain": [
          0,
          1
        ],
        "nice": false
      }
    },
    "y": {
      "field": "share",
      "type": "quantitative",
      "axis": null,
      "scale": {
        "domain": [
          0.12,
          1.08
        ],
        "nice": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 55
        },
        "strokeWidth": 2
      },
      "encoding": {
        "detail": {
          "field": "activity",
          "type": "nominal"
        },
        "color": {
          "field": "activity",
          "type": "nominal",
          "scale": {
            "range": [
              "#2457D6",
              "#007F78",
              "#B47716",
              "#805C89"
            ]
          },
          "legend": null
        },
        "strokeDash": {
          "field": "activity",
          "type": "nominal",
          "legend": null
        },
        "tooltip": [
          {
            "field": "activity",
            "type": "nominal"
          },
          {
            "field": "year",
            "type": "ordinal"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Participation",
            "format": ".1%"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -12,
        "fontSize": 12,
        "color": "#162B4D"
      },
      "encoding": {
        "text": {
          "field": "share",
          "type": "quantitative",
          "format": ".1%"
        },
        "detail": {
          "field": "activity",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2025"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#162B4D"
      },
      "encoding": {
        "text": {
          "field": "activity",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "position": 0.06,
            "share": 1.065,
            "year": "2024"
          },
          {
            "position": 0.53,
            "share": 1.065,
            "year": "2025"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#162B4D"
      },
      "encoding": {
        "text": {
          "field": "year",
          "type": "nominal"
        }
      }
    }
  ]
}