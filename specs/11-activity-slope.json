{
  "width": "container",
  "height": 320,
  "config": {
    "font": "IBM Plex Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "gridColor": "#DFE6EE",
      "domain": false,
      "tickColor": "#B3C2D3",
      "labelColor": "#4E6078",
      "titleColor": "#162B4D",
      "titlePadding": 14,
      "labelLimit": 150,
      "labelPadding": 7,
      "labelOverlap": true
    },
    "legend": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "orient": "bottom",
      "title": null,
      "labelLimit": 240
    },
    "title": {
      "fontSize": 16,
      "anchor": "start",
      "color": "#162B4D",
      "lineHeight": 20
    },
    "text": {
      "fontSize": 16,
      "lineHeight": 20,
      "color": "#162B4D"
    }
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/activities.json"
  },
  "transform": [
    {
      "filter": "datum.activity != 'Go shopping'"
    },
    {
      "calculate": "datum.year == 2024 ? 0.08 : 0.92",
      "as": "position"
    }
  ],
  "encoding": {
    "x": {
      "field": "position",
      "type": "quantitative",
      "axis": null,
      "scale": {
        "domain": [
          0,
          1
        ],
        "nice": false
      }
    },
    "y": {
      "field": "share",
      "type": "quantitative",
      "axis": null,
      "scale": {
        "domain": [
          0.12,
          1.08
        ],
        "nice": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 55
        },
        "strokeWidth": 2
      },
      "encoding": {
        "detail": {
          "field": "activity",
          "type": "nominal"
        },
        "color": {
          "field": "activity",
          "type": "nominal",
          "scale": {
            "domain": [
              "Dine out",
              "Sightseeing",
              "Go to the beach",
              "National/state parks"
            ],
            "range": [
              "#008B9C",
              "#6E3D60",
              "#526F24",
              "#A4513A"
            ]
          },
          "legend": null
        },
        "strokeDash": {
          "field": "activity",
          "type": "nominal",
          "scale": {
            "domain": [
              "Dine out",
              "Sightseeing",
              "Go to the beach",
              "National/state parks"
            ],
            "range": [
              [],
              [
                8,
                4
              ],
              [
                3,
                3
              ],
              [
                10,
                3,
                2,
                3
              ]
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "activity_full",
            "type": "nominal"
          },
          {
            "field": "year",
            "type": "ordinal"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Participation",
            "format": ".1%"
          }
        ]
      },
      "transform": [
        {
          "calculate": "datum.activity == 'National/state parks' ? 'National and state parks' : datum.activity",
          "as": "activity_full"
        }
      ]
    },
    {
      "mark": {
        "type": "text",
        "dy": -22,
        "fontSize": 15,
        "color": "#162B4D"
      },
      "encoding": {
        "text": {
          "field": "share",
          "type": "quantitative",
          "format": ".1%"
        },
        "detail": {
          "field": "activity",
          "type": "nominal"
        }
      },
      "transform": [
        {
          "filter": "datum.activity == 'Sightseeing'"
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "position": 0.08,
            "share": 1.065,
            "year": "2024"
          },
          {
            "position": 0.92,
            "share": 1.065,
            "year": "2025"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 15,
        "fontWeight": "bold",
        "color": "#162B4D"
      },
      "encoding": {
        "text": {
          "field": "year",
          "type": "nominal"
        }
      }
    }
  ]
}