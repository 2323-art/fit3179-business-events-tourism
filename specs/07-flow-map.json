{
  "width": "container",
  "height": 440,
  "config": {
    "font": "IBM Plex Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "gridColor": "#DFE6EE",
      "domain": false,
      "tickColor": "#B3C2D3",
      "labelColor": "#000000",
      "titleColor": "#162B4D",
      "titlePadding": 14,
      "labelLimit": 150,
      "labelPadding": 7,
      "labelOverlap": true
    },
    "legend": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "orient": "bottom",
      "title": null,
      "labelLimit": 240
    },
    "title": {
      "fontSize": 16,
      "anchor": "start",
      "color": "#162B4D",
      "lineHeight": 20
    },
    "text": {
      "fontSize": 16,
      "lineHeight": 20,
      "color": "#162B4D"
    }
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -150,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/world.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E8EFF5",
        "stroke": "white",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/routes.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "strokeOpacity": 1,
        "cursor": "pointer"
      },
      "encoding": {
        "strokeWidth": {
          "field": "properties.visitors",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              165000
            ],
            "range": [
              0,
              12
            ]
          },
          "legend": {
            "title": "Visitor trips",
            "values": [
              50000,
              100000,
              150000
            ],
            "format": ",.0f",
            "symbolType": "stroke",
            "symbolSize": 700,
            "symbolStrokeColor": "#2457D6"
          }
        },
        "stroke": {
          "value": "#2457D6"
        },
        "tooltip": [
          {
            "field": "country_full",
            "type": "nominal",
            "title": "Origin"
          },
          {
            "field": "properties.visitors",
            "type": "quantitative",
            "title": "Visitor trips",
            "format": ",.0f"
          }
        ],
        "opacity": {
          "condition": {
            "test": "originFocus == 'All origins' || datum.properties.country == originFocus",
            "value": 0.8
          },
          "value": 0.1
        }
      },
      "transform": [
        {
          "calculate": "datum.properties.country == \"USA\" ? \"United States\" : datum.properties.country == \"UK\" ? \"United Kingdom\" : datum.properties.country == \"NSW\" ? \"New South Wales\" : datum.properties.country == \"VIC\" ? \"Victoria\" : datum.properties.country == \"QLD\" ? \"Queensland\" : datum.properties.country == \"WA\" ? \"Western Australia\" : datum.properties.country == \"SA\" ? \"South Australia\" : datum.properties.country == \"ACT\" ? \"Australian Capital Territory\" : datum.properties.country == \"NT\" ? \"Northern Territory\" : datum.properties.country == \"TAS\" ? \"Tasmania\" : datum.properties.country",
          "as": "country_full"
        }
      ]
    },
    {
      "data": {
        "url": "data/origins.json"
      },
      "mark": {
        "type": "circle",
        "size": 50,
        "color": "#162B4D",
        "cursor": "pointer"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "country_full",
            "type": "nominal",
            "title": "Origin"
          },
          {
            "field": "visitors",
            "type": "quantitative",
            "title": "Visitor trips",
            "format": ",.0f"
          }
        ],
        "opacity": {
          "condition": {
            "test": "originFocus == 'All origins' || datum.country == originFocus",
            "value": 1
          },
          "value": 0.2
        },
        "stroke": {
          "condition": {
            "test": "datum.country == originFocus",
            "value": "#2457D6"
          },
          "value": "transparent"
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.country == originFocus",
            "value": 2
          },
          "value": 0
        }
      },
      "transform": [
        {
          "calculate": "datum.country == \"USA\" ? \"United States\" : datum.country == \"UK\" ? \"United Kingdom\" : datum.country == \"NSW\" ? \"New South Wales\" : datum.country == \"VIC\" ? \"Victoria\" : datum.country == \"QLD\" ? \"Queensland\" : datum.country == \"WA\" ? \"Western Australia\" : datum.country == \"SA\" ? \"South Australia\" : datum.country == \"ACT\" ? \"Australian Capital Territory\" : datum.country == \"NT\" ? \"Northern Territory\" : datum.country == \"TAS\" ? \"Tasmania\" : datum.country",
          "as": "country_full"
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "longitude": 149.129,
            "latitude": -35.283,
            "label": "Australia"
          }
        ]
      },
      "mark": {
        "type": "text",
        "dy": 18,
        "fontWeight": "bold",
        "color": "#162B4D"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "data/origins.json"
      },
      "mark": {
        "type": "text",
        "fontSize": 15,
        "fontWeight": "bold",
        "color": "#162B4D",
        "align": {
          "expr": "datum.country == 'USA' || datum.country == 'India' || datum.country == 'Malaysia' || datum.country == 'Singapore' ? 'right' : 'left'"
        },
        "dx": {
          "expr": "datum.country == 'USA' || datum.country == 'India' || datum.country == 'Malaysia' || datum.country == 'Singapore' ? -8 : 8"
        },
        "dy": {
          "expr": "datum.country == 'UK' ? -24 : datum.country == 'Singapore' ? 20 : datum.country == 'Malaysia' ? -10 : datum.country == 'Japan' ? -4 : -12"
        },
        "cursor": "pointer"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "country_name",
          "type": "nominal"
        },
        "opacity": {
          "condition": {
            "test": "originFocus == 'All origins' || datum.country == originFocus",
            "value": 1
          },
          "value": 0.25
        }
      },
      "transform": [
        {
          "filter": "originFocus == 'All origins' || datum.country == originFocus"
        },
        {
          "calculate": "datum.country == \"USA\" ? \"United States\" : datum.country == \"UK\" ? \"United Kingdom\" : datum.country == \"NSW\" ? \"New South Wales\" : datum.country == \"VIC\" ? \"Victoria\" : datum.country == \"QLD\" ? \"Queensland\" : datum.country == \"WA\" ? \"Western Australia\" : datum.country == \"SA\" ? \"South Australia\" : datum.country == \"ACT\" ? \"Australian Capital Territory\" : datum.country == \"NT\" ? \"Northern Territory\" : datum.country == \"TAS\" ? \"Tasmania\" : datum.country",
          "as": "country_name"
        }
      ]
    }
  ],
  "params": [
    {
      "name": "originFocus",
      "value": "All origins"
    }
  ]
}
