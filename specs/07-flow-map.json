{
  "width": "container",
  "height": 440,
  "config": {
    "font": "IBM Plex Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "gridColor": "#DFE6EE",
      "domain": false,
      "tickColor": "#B3C2D3",
      "labelColor": "#162B4D",
      "titleColor": "#162B4D",
      "titlePadding": 12,
      "labelLimit": 150
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "orient": "bottom",
      "title": null
    },
    "title": {
      "fontSize": 14,
      "anchor": "start",
      "color": "#162B4D"
    }
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -150,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/world.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E8EFF5",
        "stroke": "white",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/routes.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "strokeOpacity": 1
      },
      "encoding": {
        "strokeWidth": {
          "field": "properties.visitors",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              165000
            ],
            "range": [
              0,
              12
            ]
          },
          "legend": {
            "title": "Visitor trips",
            "values": [
              50000,
              100000,
              150000
            ],
            "format": "~s",
            "symbolType": "stroke",
            "symbolSize": 700,
            "symbolStrokeColor": "#2457D6"
          }
        },
        "stroke": {
          "condition": {
            "test": "datum.properties.country == 'Malaysia'",
            "value": "#007F78"
          },
          "value": "#2457D6"
        },
        "tooltip": [
          {
            "field": "properties.country",
            "type": "nominal",
            "title": "Origin"
          },
          {
            "field": "properties.visitors",
            "type": "quantitative",
            "title": "Visitor trips",
            "format": ",.0f"
          }
        ],
        "opacity": {
          "condition": {
            "test": "originFocus == 'All origins' || datum.properties.country == originFocus",
            "value": 0.8
          },
          "value": 0.1
        }
      }
    },
    {
      "data": {
        "url": "data/origins.json"
      },
      "mark": {
        "type": "circle",
        "size": 50,
        "color": "#162B4D"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Origin"
          },
          {
            "field": "visitors",
            "type": "quantitative",
            "title": "Visitor trips",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 149.129,
            "latitude": -35.283,
            "label": "Australia"
          }
        ]
      },
      "mark": {
        "type": "text",
        "dy": 18,
        "fontWeight": "bold",
        "color": "#162B4D"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "data/origins.json"
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#162B4D",
        "align": {
          "expr": "datum.country == 'UK' || datum.country == 'India' || datum.country == 'Malaysia' ? 'right' : 'left'"
        },
        "dx": {
          "expr": "datum.country == 'UK' || datum.country == 'India' || datum.country == 'Malaysia' ? -8 : 8"
        },
        "dy": {
          "expr": "datum.country == 'Singapore' ? 18 : datum.country == 'Malaysia' ? -8 : -10"
        }
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "country",
          "type": "nominal"
        },
        "opacity": {
          "condition": {
            "test": "originFocus == 'All origins' || datum.country == originFocus",
            "value": 1
          },
          "value": 0.25
        }
      }
    }
  ],
  "params": [
    {
      "name": "originFocus",
      "value": "All origins"
    }
  ]
}