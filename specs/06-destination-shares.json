{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "IBM Plex Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "gridColor": "#DFE6EE",
      "domain": false,
      "tickColor": "#B3C2D3",
      "labelColor": "#000000",
      "titleColor": "#162B4D",
      "titlePadding": 14,
      "labelLimit": 150,
      "labelPadding": 7,
      "labelOverlap": true
    },
    "legend": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "orient": "bottom",
      "title": null,
      "labelLimit": 240
    },
    "title": {
      "fontSize": 16,
      "anchor": "start",
      "color": "#162B4D",
      "lineHeight": 20
    },
    "text": {
      "fontSize": 16,
      "lineHeight": 20,
      "color": "#162B4D"
    }
  },
  "data": {
    "url": "data/regions.json"
  },
  "params": [
    {
      "name": "stateFocus",
      "value": "All states"
    }
  ],
  "transform": [
    {
      "filter": "datum.value > 0"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "value",
          "as": "state_total"
        }
      ],
      "groupby": [
        "parent"
      ]
    },
    {
      "calculate": "datum.value / datum.state_total",
      "as": "share"
    },
    {
      "calculate": "datum.name == 'ACT (all)' ? 'Whole territory (no split)' : datum.name == 'Hobart & south' ? 'Hobart and the South' : datum.name",
      "as": "destination_label"
    },
    {
      "calculate": "format(datum.share, '.1%') + ' · AUD ' + format(datum.value / 1e6, ',.0f') + 'm'",
      "as": "value_label"
    }
  ],
  "concat": [
    {
      "title": {
        "text": "New South Wales",
        "subtitle": [
          "Displayed total · AUD 5.848bn"
        ],
        "anchor": "start",
        "fontSize": 16,
        "subtitleFontSize": 14,
        "offset": 18
      },
      "width": 260,
      "height": 186,
      "transform": [
        {
          "filter": "datum.parent == 'NSW'"
        }
      ],
      "encoding": {
        "y": {
          "field": "name",
          "type": "nominal",
          "sort": [
            "Sydney",
            "Regional NSW"
          ],
          "axis": null,
          "scale": {
            "domain": [
              "Sydney",
              "Regional NSW",
              "empty-0"
            ]
          }
        },
        "x": {
          "field": "share",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ],
            "nice": false
          },
          "axis": {
            "values": [
              0,
              0.5,
              1
            ],
            "format": ".0%",
            "title": null,
            "labelFontSize": 14,
            "grid": true
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "bar",
            "size": 12,
            "yOffset": 12,
            "color": "#443675"
          },
          "encoding": {
            "opacity": {
              "condition": {
                "test": "stateFocus == 'All states' || datum.parent == stateFocus",
                "value": 1
              },
              "value": 0.4
            },
            "tooltip": [
              {
                "field": "name",
                "title": "Destination"
              },
              {
                "field": "share",
                "type": "quantitative",
                "format": ".1%",
                "title": "Share of displayed state spending"
              },
              {
                "field": "value",
                "type": "quantitative",
                "format": "$,.0f",
                "title": "Spending (AUD)"
              },
              {
                "field": "state_total",
                "type": "quantitative",
                "format": "$,.0f",
                "title": "Displayed state total (AUD)"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dy": -16,
            "fontSize": 14,
            "color": "#000000"
          },
          "encoding": {
            "x": {
              "value": 0
            },
            "text": {
              "field": "destination_label"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dy": -2,
            "fontSize": 14,
            "color": "#000000"
          },
          "encoding": {
            "x": {
              "value": 0
            },
            "text": {
              "field": "value_label"
            }
          }
        }
      ]
    },
