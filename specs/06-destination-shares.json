{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "2025 destination spending within each state. Each stacked bar totals 100% of displayed destinations; regional spending is at the right. Labels retain shares, AUD amounts and state totals.",
  "width": 560,
  "padding": {
    "left": 6,
    "right": 6,
    "top": 30,
    "bottom": 0
  },
  "autosize": "none",
  "signals": [
    {
      "name": "stateFocus",
      "value": "All states"
    },
    {
      "name": "compact",
      "update": "width < 510"
    },
    {
      "name": "rowHeight",
      "update": "compact ? 142 : 108"
    },
    {
      "name": "height",
      "update": "rowHeight * 8"
    },
    {
      "name": "barTop",
      "update": "compact ? 45 : 27"
    }
  ],
  "data": [
    {
      "name": "metadata",
      "values": [
        {
          "key": "NSW",
          "label": "New South Wales",
          "colour": "#443675",
          "row": 0
        },
        {
          "key": "VIC",
          "label": "Victoria",
          "colour": "#795637",
          "row": 1
        },
        {
          "key": "QLD",
          "label": "Queensland",
          "colour": "#748128",
          "row": 2
        },
        {
          "key": "WA",
          "label": "Western Australia",
          "colour": "#D2BA68",
          "row": 3
        },
        {
          "key": "SA",
          "label": "South Australia",
          "colour": "#5E608B",
          "row": 4
        },
        {
          "key": "ACT",
          "label": "Australian Capital Territory",
          "colour": "#386453",
          "row": 5
        },
        {
          "key": "NT",
          "label": "Northern Territory",
          "colour": "#9A8468",
          "row": 6
        },
        {
          "key": "TAS",
          "label": "Tasmania",
          "colour": "#4F7F91",
          "row": 7
        }
      ]
    },
    {
      "name": "destinations",
      "url": "data/regions.json",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.value > 0"
        },
        {
          "type": "lookup",
          "from": "metadata",
          "key": "key",
          "fields": [
            "parent"
          ],
          "values": [
            "label",
            "colour",
            "row"
          ],
          "as": [
            "state",
            "colour",
            "row"
          ]
        },
        {
          "type": "formula",
          "expr": "indexof(datum.name, 'Regional ') == 0 ? 2 : datum.name == 'Gold Coast' ? 1 : 0",
          "as": "partOrder"
        },
        {
          "type": "formula",
          "expr": "datum.partOrder == 2 ? 0.35 : datum.partOrder == 1 ? 0.65 : 1",
          "as": "tone"
        },
        {
          "type": "joinaggregate",
          "groupby": [
            "parent"
          ],
          "fields": [
            "value",
            null
          ],
          "ops": [
            "sum",
            "count"
          ],
          "as": [
            "total",
            "parts"
          ]
        },
        {
          "type": "formula",
          "expr": "datum.value / datum.total",
          "as": "share"
        },
        {
          "type": "stack",
          "groupby": [
            "parent"
          ],
          "field": "value",
          "sort": {
            "field": "partOrder",
            "order": "ascending"
          },
          "offset": "normalize",
          "as": [
            "start",
            "end"
          ]
        },
        {
          "type": "window",
          "groupby": [
            "parent"
          ],
          "sort": {
            "field": "partOrder",
            "order": "ascending"
          },
          "ops": [
            "row_number"
          ],
          "as": [
            "partIndex"
          ]
        },
        {
          "type": "formula",
          "expr": "datum.name == 'ACT (all)' ? 'Whole territory (no split)' : datum.name",
          "as": "label"
        },
        {
          "type": "formula",
          "expr": "format(datum.share, '.1%') + ' \u00b7 AUD ' + format(datum.value / 1e6, ',.0f') + 'm'",
          "as": "valueLabel"
        },
        {
          "type": "formula",
          "expr": "datum.parts == 1 || datum.partIndex == 1 ? 'left' : datum.partIndex == datum.parts ? 'right' : 'center'",
          "as": "align"
        }
      ]
    },
    {
      "name": "totals",
      "source": "destinations",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "parent",
            "state",
            "row",
            "colour"
          ],
          "fields": [
            "value"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "total"
          ]
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "share",
      "type": "linear",
      "domain": [
        0,
        1
      ],
      "range": [
        0,
        {
          "signal": "width"
        }
      ],
      "nice": false,
      "zero": true
    }
  ],
  "axes": [
    {
      "scale": "share",
      "orient": "top",
      "values": [
        0,
        0.25,
        0.5,
        0.75,
        1
      ],
      "format": ".0%",
      "domain": false,
      "tickSize": 3,
      "labelPadding": 5,
      "labelFont": "IBM Plex Sans",
      "labelFontSize": 13,
      "labelColor": "#162B4D",
      "tickColor": "#B3C2D3",
      "encode": {
        "labels": {
          "update": {
            "align": {
              "signal": "datum.value == 0 ? 'left' : datum.value == 1 ? 'right' : 'center'"
            }
          }
        }
      }
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "totals"
      },
      "encode": {
        "update": {
          "x": {
            "value": -3
          },
          "x2": {
            "signal": "width + 3"
          },
          "y": {
            "signal": "datum.row * rowHeight - 5"
          },
          "height": {
            "signal": "rowHeight - 7"
          },
          "fill": {
            "value": "transparent"
          },
          "stroke": {
            "signal": "stateFocus == datum.parent ? '#162B4D' : 'transparent'"
          },
          "strokeWidth": {
            "value": 2
          },
          "cornerRadius": {
            "value": 3
          }
        }
      }
    },
    {
      "type": "text",
      "name": "state_names",
      "from": {
        "data": "totals"
      },
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "y": {
            "signal": "datum.row * rowHeight"
          },
          "text": {
            "field": "state"
          },
          "font": {
            "value": "IBM Plex Sans"
          },
          "fontSize": {
            "value": 15
          },
          "fill": {
            "value": "#162B4D"
          },
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "top"
          },
          "fontWeight": {
            "value": 600
          }
        }
      }
    },
    {
      "type": "text",
      "name": "state_totals",
      "from": {
        "data": "totals"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "compact ? 0 : width"
          },
          "y": {
            "signal": "datum.row * rowHeight + (compact ? 21 : 1)"
          },
          "text": {
            "signal": "'Total \u00b7 AUD ' + format(datum.total / 1e9, '.3f') + 'bn'"
          },
          "font": {
            "value": "IBM Plex Sans"
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "value": "#162B4D"
          },
          "align": {
            "signal": "compact ? 'left' : 'right'"
          },
          "baseline": {
            "value": "top"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "destination_segments",
      "from": {
        "data": "destinations"
      },
      "encode": {
        "update": {
          "x": {
            "scale": "share",
            "field": "start"
          },
          "x2": {
            "scale": "share",
            "field": "end"
          },
          "y": {
            "signal": "datum.row * rowHeight + barTop"
          },
          "height": {
            "value": 20
          },
          "fill": {
            "field": "colour"
          },
          "fillOpacity": {
            "field": "tone"
          },
          "stroke": {
            "value": "white"
          },
          "strokeWidth": {
            "value": 1.5
          },
          "tooltip": {
            "signal": "{'State':datum.state,'Destination':datum.label,'Share of displayed spending':format(datum.share,'.1%'),'Spending (AUD)':format(datum.value,',.0f'),'Displayed state total (AUD)':format(datum.total,',.0f')}"
          },
          "description": {
            "signal": "datum.state + ', ' + datum.label + ': ' + datum.valueLabel"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "destination_names",
      "from": {
        "data": "destinations"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.parts == 1 ? 0 : (datum.partIndex - 1) * width / (datum.parts - 1)"
          },
          "y": {
            "signal": "datum.row * rowHeight + barTop + 29"
          },
          "text": {
            "field": "label"
          },
          "font": {
            "value": "IBM Plex Sans"
          },
          "fontSize": {
            "value": 14
          },
          "fill": {
            "value": "#162B4D"
          },
          "align": {
            "field": "align"
          },
          "baseline": {
            "value": "top"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "destination_values",
      "from": {
        "data": "destinations"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.parts == 1 ? 0 : (datum.partIndex - 1) * width / (datum.parts - 1)"
          },
          "y": {
            "signal": "datum.row * rowHeight + barTop + 49"
          },
          "text": {
            "signal": "compact ? format(datum.share, '.1%') : datum.valueLabel"
          },
          "font": {
            "value": "IBM Plex Sans"
          },
          "fontSize": {
            "value": 14
          },
          "fill": {
            "value": "#162B4D"
          },
          "align": {
            "field": "align"
          },
          "baseline": {
            "value": "top"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "destination_amounts",
      "from": {
        "data": "destinations"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.parts == 1 ? 0 : (datum.partIndex - 1) * width / (datum.parts - 1)"
          },
          "y": {
            "signal": "datum.row * rowHeight + barTop + 69"
          },
          "text": {
            "signal": "compact ? 'AUD ' + format(datum.value / 1e6, ',.0f') + 'm' : ''"
          },
          "font": {
            "value": "IBM Plex Sans"
          },
          "fontSize": {
            "value": 14
          },
          "fill": {
            "value": "#162B4D"
          },
          "align": {
            "field": "align"
          },
          "baseline": {
            "value": "top"
          }
        }
      }
    }
  ]
}
