{
  "width": "container",
  "height": 180,
  "config": {
    "font": "IBM Plex Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "gridColor": "#DFE6EE",
      "domain": false,
      "tickColor": "#B3C2D3",
      "labelColor": "#000000",
      "titleColor": "#162B4D",
      "titlePadding": 14,
      "labelLimit": 150,
      "labelPadding": 7,
      "labelOverlap": true
    },
    "legend": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "orient": "bottom",
      "title": null,
      "labelLimit": 240
    },
    "title": {
      "fontSize": 16,
      "anchor": "start",
      "color": "#162B4D",
      "lineHeight": 20
    },
    "text": {
      "fontSize": 16,
      "lineHeight": 20,
      "color": "#162B4D"
    }
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "hconcat": [
    {
      "width": 180,
      "height": 180,
      "title": "Visitor trips",
      "data": {
        "url": "data/waffle.json"
      },
      "transform": [
        {
          "filter": "datum.metric === \"Visitor trips\""
        }
      ],
      "mark": {
        "type": "rect",
        "cornerRadius": 2,
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "ordinal",
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "ordinal",
          "axis": null
        },
        "color": {
          "field": "traveller",
          "type": "nominal",
          "scale": {
            "domain": [
              "Domestic day",
              "Domestic overnight",
              "International"
            ],
            "range": [
              "#B47716",
              "#007F78",
              "#2457D6"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "traveller",
            "type": "nominal",
            "title": "Traveller"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Exact share",
            "format": ".1%"
          }
        ]
      }
    },
    {
      "width": 180,
      "height": 180,
      "title": [
        "Spending in",
        "Australia"
      ],
      "data": {
        "url": "data/waffle.json"
      },
      "transform": [
        {
          "filter": "datum.metric === \"Spending in Australia\""
        }
      ],
      "mark": {
        "type": "rect",
        "cornerRadius": 2,
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "ordinal",
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "ordinal",
          "axis": null
        },
        "color": {
          "field": "traveller",
          "type": "nominal",
          "scale": {
            "domain": [
              "Domestic day",
              "Domestic overnight",
              "International"
            ],
            "range": [
              "#B47716",
              "#007F78",
              "#2457D6"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "traveller",
            "type": "nominal",
            "title": "Traveller"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Exact share",
            "format": ".1%"
          }
        ]
      }
    }
  ],
  "spacing": 28,
  "resolve": {
    "scale": {
      "color": "shared"
    }
  }
}