{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "IBM Plex Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "gridColor": "#DFE6EE",
      "domain": false,
      "tickColor": "#B3C2D3",
      "labelColor": "#4E6078",
      "titleColor": "#162B4D",
      "titlePadding": 14,
      "labelLimit": 170,
      "labelPadding": 7,
      "labelOverlap": true
    },
    "legend": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "orient": "bottom",
      "title": null,
      "labelLimit": 240
    },
    "title": {
      "fontSize": 16,
      "anchor": "start",
      "color": "#162B4D",
      "lineHeight": 20,
      "subtitleFontSize": 15,
      "subtitleLineHeight": 20,
      "subtitleColor": "#4E6078",
      "offset": 14
    },
    "text": {
      "fontSize": 16,
      "lineHeight": 20,
      "color": "#162B4D"
    }
  },
  "data": {
    "url": "data/waterfall.json"
  },
  "transform": [
    {
      "calculate": "datum.label == 'USA' ? 'United States' : datum.label",
      "as": "display_name"
    }
  ],
  "spacing": 36,
  "vconcat": [
    {
      "title": {
        "text": "National totals",
        "subtitle": "Zero-based spending scale"
      },
      "height": 86,
      "transform": [
        {
          "filter": "datum.kind == 'Total'"
        }
      ],
      "encoding": {
        "y": {
          "field": "label",
          "type": "ordinal",
          "title": null,
          "sort": [
            "2024",
            "2025"
          ],
          "axis": {
            "labelAngle": 0
          }
        },
        "x": {
          "field": "end",
          "type": "quantitative",
          "title": "Spending in Australia (AUD billions)",
          "scale": {
            "domain": [
              0,
              3
            ],
            "nice": false
          },
          "axis": {
            "tickCount": 4
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "bar",
            "size": 24,
            "color": "#2457D6"
          },
          "encoding": {
            "tooltip": [
              {
                "field": "display_name",
                "title": "Origin / group"
              },
              {
                "field": "value",
                "title": "Amount (AUD billions)",
                "format": "+.3f"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -8,
            "color": "white",
            "fontWeight": "bold",
            "fontSize": 15
          },
          "encoding": {
            "text": {
              "field": "end",
              "format": ".2f"
            }
          }
        }
      ]
    },
    {
      "title": {
        "text": "How the total changed",
        "subtitle": [
          "Enlarged cumulative scale: each step is a gain or loss.",
          "Signed labels show each contribution in AUD millions."
        ]
      },
      "height": 400,
      "transform": [
        {
          "filter": "datum.kind != 'Total'"
        },
        {
          "window": [
            {
              "op": "lead",
              "field": "display_name",
              "as": "next_name"
            }
          ],
          "sort": [
            {
              "field": "order"
            }
          ]
        }
      ],
      "encoding": {
        "y": {
          "field": "display_name",
          "type": "ordinal",
          "sort": {
            "field": "order",
            "order": "ascending"
          },
          "title": null,
          "axis": {
            "labelAngle": 0,
            "labelLimit": 170,
            "labelPadding": 8,
            "labelExpr": "datum.label == 'Other published markets' ? ['Other published','markets'] : datum.label == 'Unpublished + rounding' ? ['Unpublished','+ rounding'] : datum.label"
          }
        },
        "x": {
          "field": "start",
          "type": "quantitative",
          "title": "Cumulative spending (AUD billions)",
          "scale": {
            "domain": [
              2.3,
              2.8
            ],
            "zero": false,
            "nice": false
          },
          "axis": {
            "tickCount": 5,
            "format": ".1f"
          }
        }
      },
      "layer": [
        {
          "transform": [
            {
              "filter": "datum.next_name != null"
            }
          ],
          "mark": {
            "type": "rule",
            "strokeDash": [
              3,
              3
            ],
            "color": "#8292A7"
          },
          "encoding": {
            "x": {
              "field": "end"
            },
            "y2": {
              "field": "next_name"
            }
          }
        },
        {
          "mark": {
            "type": "bar",
            "size": 22
          },
          "encoding": {
            "x2": {
              "field": "end"
            },
            "color": {
              "field": "kind",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Total",
                  "Increase",
                  "Decrease"
                ],
                "range": [
                  "#2457D6",
                  "#762A83",
                  "#C45118"
                ]
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "display_name",
                "title": "Origin / group"
              },
              {
                "field": "value",
                "title": "Amount (AUD billions)",
                "format": "+.3f"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "calculate": "format(datum.value*1000,'+.1f')",
              "as": "change_label"
            },
            {
              "calculate": "max(datum.start,datum.end)",
              "as": "label_x"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 7,
            "fontSize": 15,
            "color": "#162B4D"
          },
          "encoding": {
            "x": {
              "field": "label_x"
            },
            "text": {
              "field": "change_label"
            }
          }
        }
      ]
    }
  ],
  "resolve": {
    "scale": {
      "x": "independent",
      "y": "independent"
    }
  }
}
