{
  "width": "container",
  "height": 380,
  "config": {
    "font": "IBM Plex Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "gridColor": "#DFE6EE",
      "domain": false,
      "tickColor": "#B3C2D3",
      "labelColor": "#4E6078",
      "titleColor": "#162B4D",
      "titlePadding": 14,
      "labelLimit": 150,
      "labelPadding": 7,
      "labelOverlap": true
    },
    "legend": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "orient": "bottom",
      "title": null,
      "labelLimit": 240
    },
    "title": {
      "fontSize": 16,
      "anchor": "start",
      "color": "#162B4D",
      "lineHeight": 20
    },
    "text": {
      "fontSize": 16,
      "lineHeight": 20,
      "color": "#162B4D"
    }
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0,
      0
    ],
    "center": [
      0,
      -28
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#EDF1F5",
        "stroke": "white"
      }
    },
    {
      "data": {
        "url": "data/states.json"
      },
      "mark": {
        "type": "circle",
        "fill": "#59626D",
        "fillOpacity": 0.55,
        "stroke": "#59626D",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "visitors",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              7500000
            ],
            "range": [
              0,
              4400
            ]
          },
          "legend": {
            "title": [
              "State visits",
              "(millions)"
            ],
            "format": ",.0f",
            "values": [
              1000000,
              4000000,
              7000000
            ],
            "labelExpr": "format(datum.value / 1e6, '.0f')"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal"
          },
          {
            "field": "visitors",
            "type": "quantitative",
            "title": "State visits",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/states.json"
      },
      "mark": {
        "type": "text",
        "dy": -3,
        "fontWeight": "bold",
        "color": "#162B4D",
        "fontSize": 15,
        "lineBreak": "\n",
        "lineHeight": 18
      },
      "encoding": {
        "longitude": {
          "field": "label_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "label_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "state_label",
          "type": "nominal"
        }
      },
      "transform": [
        {
          "filter": "indexof(['NSW','VIC','QLD'], datum.code)>=0"
        },
        {
          "calculate": "datum.code == 'NSW' ? 'New South\\nWales' : datum.code == 'QLD' ? 'Queensland' : 'Victoria'",
          "as": "state_label"
        }
      ]
    }
  ]
}