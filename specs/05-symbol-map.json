{
  "width": "container",
  "height": 360,
  "config": {
    "font": "IBM Plex Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "gridColor": "#DFE6EE",
      "domain": false,
      "tickColor": "#B3C2D3",
      "labelColor": "#000000",
      "titleColor": "#162B4D",
      "titlePadding": 14,
      "labelLimit": 150,
      "labelPadding": 7,
      "labelOverlap": true
    },
    "legend": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "orient": "bottom",
      "title": null,
      "labelLimit": 240
    },
    "title": {
      "fontSize": 16,
      "anchor": "start",
      "color": "#162B4D",
      "lineHeight": 20
    },
    "text": {
      "fontSize": 16,
      "lineHeight": 20,
      "color": "#162B4D"
    }
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0,
      0
    ],
    "center": [
      0,
      -28
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#EDF1F5",
        "stroke": "white"
      }
    },
    {
      "data": {
        "url": "data/states.json"
      },
      "mark": {
        "type": "circle",
        "fillOpacity": 1,
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "visitors",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              7500000
            ],
            "range": [
              0,
              4400
            ]
          },
          "legend": {
            "title": [
              "State visits",
              "(millions)"
            ],
            "format": ",.0f",
            "values": [
              1000000,
              4000000,
              7000000
            ],
            "labelExpr": "format(datum.value / 1e6, '.0f')",
            "symbolFillColor": "#FFFFFF",
            "symbolStrokeColor": "#162B4D",
            "symbolStrokeWidth": 1.5
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal"
          },
          {
            "field": "visitors",
            "type": "quantitative",
            "title": "State visits",
            "format": ",.0f"
          }
        ],
        "color": {
          "field": "code",
          "type": "nominal",
          "scale": {
            "domain": [
              "NSW",
              "VIC",
              "QLD",
              "WA",
              "SA",
              "ACT",
              "NT",
              "TAS"
            ],
            "range": [
              "#443675",
              "#795637",
              "#748128",
              "#D2BA68",
              "#5E608B",
              "#386453",
              "#9A8468",
              "#4F7F91"
            ]
          },
          "legend": null
        },
        "opacity": {
          "condition": {
            "test": "stateFocus == 'All states' || datum.code == stateFocus",
            "value": 1
          },
          "value": 0.18
        },
        "stroke": {
          "value": "#FFFFFF"
        },
        "order": {
          "field": "visitors",
          "type": "quantitative",
          "sort": "descending"
        }
      }
    },
    {
      "data": {
        "url": "data/states.json"
      },
      "transform": [
        {
          "filter": "stateFocus == 'All states' ? (datum.code == 'NSW' || (width >= 400 && (datum.code == 'QLD' || datum.code == 'VIC'))) : datum.code == stateFocus"
        },
        {
          "calculate": "datum.code == 'QLD' ? 153 : datum.code == 'NSW' ? 156 : datum.code == 'VIC' ? 137 : datum.code == 'ACT' ? 156 : datum.code == 'TAS' ? 137 : datum.longitude",
          "as": "story_lon"
        },
        {
          "calculate": "datum.code == 'QLD' ? -15 : datum.code == 'NSW' ? -27 : datum.code == 'VIC' ? -43 : datum.code == 'ACT' ? -33 : datum.code == 'TAS' ? -40 : datum.latitude - 5",
          "as": "story_lat"
        },
        {
          "calculate": "datum.code == 'NSW' ? 'New South\\nWales' : datum.code == 'ACT' ? 'Australian Capital\\nTerritory' : datum.state",
          "as": "story_name"
        },
        {
          "calculate": "datum.story_name + '\\n' + (datum.visitors >= 1e6 ? format(datum.visitors / 1e6, '.1f') + 'm' : format(datum.visitors, ',')) + ' visits'",
          "as": "story_label"
        }
      ],
      "name": "story_state_leaders",
      "mark": {
        "type": "rule",
        "color": "#4E6078",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "story_lon"
        },
        "latitude2": {
          "field": "story_lat"
        }
      }
    },
    {
      "data": {
        "url": "data/states.json"
      },
      "transform": [
        {
          "filter": "stateFocus == 'All states' ? (datum.code == 'NSW' || (width >= 400 && (datum.code == 'QLD' || datum.code == 'VIC'))) : datum.code == stateFocus"
        },
        {
          "calculate": "datum.code == 'QLD' ? 153 : datum.code == 'NSW' ? 156 : datum.code == 'VIC' ? 137 : datum.code == 'ACT' ? 156 : datum.code == 'TAS' ? 137 : datum.longitude",
          "as": "story_lon"
        },
        {
          "calculate": "datum.code == 'QLD' ? -15 : datum.code == 'NSW' ? -27 : datum.code == 'VIC' ? -43 : datum.code == 'ACT' ? -33 : datum.code == 'TAS' ? -40 : datum.latitude - 5",
          "as": "story_lat"
        },
        {
          "calculate": "datum.code == 'NSW' ? 'New South\\nWales' : datum.code == 'ACT' ? 'Australian Capital\\nTerritory' : datum.state",
          "as": "story_name"
        },
        {
          "calculate": "datum.story_name + '\\n' + (datum.visitors >= 1e6 ? format(datum.visitors / 1e6, '.1f') + 'm' : format(datum.visitors, ',')) + ' visits'",
          "as": "story_label"
        }
      ],
      "name": "story_state_labels",
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": 600,
        "lineHeight": 17,
        "lineBreak": "\n",
        "align": "center",
        "baseline": "top",
        "dy": {
          "expr": "datum.code == 'NSW' || datum.code == 'ACT' ? -59 : datum.code == 'QLD' || datum.code == 'TAS' ? -42 : 6"
        },
        "color": "#162B4D"
      },
      "encoding": {
        "longitude": {
          "field": "story_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "story_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "story_label"
        }
      }
    }
  ],
  "params": [
    {
      "name": "stateFocus",
      "value": "All states"
    }
  ]
}
