{
  "width": "container",
  "height": 360,
  "config": {
    "font": "IBM Plex Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "gridColor": "#DFE6EE",
      "domain": false,
      "tickColor": "#B3C2D3",
      "labelColor": "#162B4D",
      "titleColor": "#162B4D",
      "titlePadding": 12,
      "labelLimit": 150,
      "tickCount": 5
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "orient": "bottom",
      "title": null
    },
    "title": {
      "fontSize": 14,
      "anchor": "start",
      "color": "#162B4D"
    }
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/markets.json"
  },
  "params": [
    {
      "name": "year",
      "value": 2025,
      "bind": {
        "input": "select",
        "options": [
          2024,
          2025
        ],
        "name": "Year: "
      }
    },
    {
      "name": "focus",
      "value": "All markets",
      "bind": {
        "input": "select",
        "options": [
          "All markets",
          "Canada",
          "China",
          "France",
          "Germany",
          "Hong Kong",
          "India",
          "Indonesia",
          "Japan",
          "Korea",
          "Malaysia",
          "Netherlands",
          "New Zealand",
          "Philippines",
          "Scandinavia",
          "Singapore",
          "UK",
          "USA",
          "Viet Nam"
        ],
        "name": "Highlight: ",
        "labels": [
          "All markets",
          "Canada",
          "China",
          "France",
          "Germany",
          "Hong Kong",
          "India",
          "Indonesia",
          "Japan",
          "Korea",
          "Malaysia",
          "Netherlands",
          "New Zealand",
          "Philippines",
          "Scandinavia",
          "Singapore",
          "United Kingdom",
          "United States",
          "Viet Nam"
        ]
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.year == year"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "circle",
        "size": 110,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "visitors",
          "type": "quantitative",
          "title": "Visitor trips",
          "axis": {
            "format": ",.0f",
            "tickCount": 3
          },
          "scale": {
            "domain": [
              0,
              185000
            ]
          }
        },
        "y": {
          "field": "spend",
          "type": "quantitative",
          "title": [
            "Spending in Australia",
            "(million Australian dollars)"
          ],
          "axis": {
            "labelExpr": "format(datum.value / 1e6, '.0f')",
            "tickCount": 4
          },
          "scale": {
            "domain": [
              0,
              400000000
            ]
          }
        },
        "color": {
          "value": "#2457D6"
        },
        "opacity": {
          "condition": {
            "test": "focus == 'All markets' || datum.country == focus",
            "value": 0.85
          },
          "value": 0.12
        },
        "tooltip": [
          {
            "field": "country_full",
            "type": "nominal",
            "title": "Origin"
          },
          {
            "field": "visitors",
            "type": "quantitative",
            "title": "Visitor trips",
            "format": ",.0f"
          },
          {
            "field": "spend",
            "type": "quantitative",
            "title": "Spending (Australian dollars)",
            "format": "$,.0f"
          }
        ]
      },
      "transform": [
        {
          "calculate": "datum.country == \"USA\" ? \"United States\" : datum.country == \"UK\" ? \"United Kingdom\" : datum.country == \"NSW\" ? \"New South Wales\" : datum.country == \"VIC\" ? \"Victoria\" : datum.country == \"QLD\" ? \"Queensland\" : datum.country == \"WA\" ? \"Western Australia\" : datum.country == \"SA\" ? \"South Australia\" : datum.country == \"ACT\" ? \"Australian Capital Territory\" : datum.country == \"NT\" ? \"Northern Territory\" : datum.country == \"TAS\" ? \"Tasmania\" : datum.country",
          "as": "country_full"
        }
      ]
    },
    {
      "transform": [
        {
          "filter": "focus == 'All markets' ? datum.country == 'Malaysia' : datum.country == focus"
        },
        {
          "calculate": "datum.country == \"USA\" ? \"United States\" : datum.country == \"UK\" ? \"United Kingdom\" : datum.country == \"NSW\" ? \"New South Wales\" : datum.country == \"VIC\" ? \"Victoria\" : datum.country == \"QLD\" ? \"Queensland\" : datum.country == \"WA\" ? \"Western Australia\" : datum.country == \"SA\" ? \"South Australia\" : datum.country == \"ACT\" ? \"Australian Capital Territory\" : datum.country == \"NT\" ? \"Northern Territory\" : datum.country == \"TAS\" ? \"Tasmania\" : datum.country",
          "as": "country_name"
        },
        {
          "calculate": "datum.country == \"USA\" ? \"United States\" : datum.country == \"UK\" ? \"United Kingdom\" : datum.country == \"NSW\" ? \"New South Wales\" : datum.country == \"VIC\" ? \"Victoria\" : datum.country == \"QLD\" ? \"Queensland\" : datum.country == \"WA\" ? \"Western Australia\" : datum.country == \"SA\" ? \"South Australia\" : datum.country == \"ACT\" ? \"Australian Capital Territory\" : datum.country == \"NT\" ? \"Northern Territory\" : datum.country == \"TAS\" ? \"Tasmania\" : datum.country",
          "as": "country_full"
        }
      ],
      "mark": {
        "type": "text",
        "dx": {
          "expr": "datum.country == 'New Zealand' ? -6 : 6"
        },
        "dy": -9,
        "align": {
          "expr": "datum.country == 'New Zealand' ? 'right' : 'left'"
        },
        "fontSize": 11,
        "color": "#162B4D"
      },
      "encoding": {
        "x": {
          "field": "visitors",
          "type": "quantitative"
        },
        "y": {
          "field": "spend",
          "type": "quantitative"
        },
        "text": {
          "field": "country_name",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "country_full",
            "type": "nominal",
            "title": "Origin"
          },
          {
            "field": "visitors",
            "type": "quantitative",
            "title": "Visitor trips",
            "format": ",.0f"
          },
          {
            "field": "spend",
            "type": "quantitative",
            "title": "Spending (Australian dollars)",
            "format": "$,.0f"
          }
        ]
      }
    }
  ]
}