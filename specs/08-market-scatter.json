{
  "width": "container",
  "height": 360,
  "config": {
    "font": "IBM Plex Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "gridColor": "#DFE6EE",
      "domain": false,
      "tickColor": "#B3C2D3",
      "labelColor": "#000000",
      "titleColor": "#162B4D",
      "titlePadding": 14,
      "labelLimit": 150,
      "tickCount": 5,
      "labelPadding": 7,
      "labelOverlap": true
    },
    "legend": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "orient": "bottom",
      "title": null,
      "labelLimit": 240
    },
    "title": {
      "fontSize": 16,
      "anchor": "start",
      "color": "#162B4D",
      "lineHeight": 20
    },
    "text": {
      "fontSize": 16,
      "lineHeight": 20,
      "color": "#162B4D"
    }
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/markets.json"
  },
  "params": [
    {
      "name": "year",
      "value": 2025
    },
    {
      "name": "focus",
      "value": "All markets"
    },
    {
      "name": "marketScale",
      "value": "All markets"
    }
  ],
  "transform": [
    {
      "filter": "datum.year == year"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "spend",
          "as": "max_spend"
        },
        {
          "op": "max",
          "field": "visitors",
          "as": "max_trips"
        }
      ]
    },
    {
      "filter": "marketScale == 'All markets' || (datum.visitors <= 40000 && datum.spend <= 120000000)"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "circle",
        "size": 85,
        "stroke": "white",
        "strokeWidth": 1,
        "cursor": "pointer"
      },
      "encoding": {
        "x": {
          "field": "visitors",
          "type": "quantitative",
          "title": "Visitor trips (k = thousand)",
          "axis": {
            "format": "~s",
            "values": {
              "expr": "marketScale == 'Smaller markets' ? [0,10000,20000,30000,40000] : [0,50000,100000,150000,200000]"
            }
          },
          "scale": {
            "domain": {
              "expr": "marketScale == 'Smaller markets' ? [0, 40000] : [0, 200000]"
            },
            "nice": false
          }
        },
        "y": {
          "field": "spend",
          "type": "quantitative",
          "title": [
            "Spending in Australia",
            "(AUD millions)"
          ],
          "axis": {
            "labelExpr": "format(datum.value / 1e6, '.0f')",
            "tickCount": 4
          },
          "scale": {
            "domain": {
              "expr": "marketScale == 'Smaller markets' ? [0, 120000000] : [0, 400000000]"
            },
            "nice": false
          }
        },
        "color": {
          "value": "#2457D6"
        },
        "opacity": {
          "condition": {
            "test": "focus == 'All markets' || datum.country == focus",
            "value": 0.85
          },
          "value": 0.12
        },
        "tooltip": [
          {
            "field": "country_full",
            "type": "nominal",
            "title": "Origin"
          },
          {
            "field": "visitors",
            "type": "quantitative",
            "title": "Visitor trips",
            "format": ",.0f"
          },
          {
            "field": "spend",
            "type": "quantitative",
            "title": "Spending (Australian dollars)",
            "format": "$,.0f"
          }
        ],
        "stroke": {
          "condition": {
            "test": "datum.country == focus",
            "value": "#162B4D"
          },
          "value": "white"
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.country == focus",
            "value": 2
          },
          "value": 1
        }
      },
      "transform": [
        {
          "calculate": "datum.country == \"USA\" ? \"United States\" : datum.country == \"UK\" ? \"United Kingdom\" : datum.country == \"NSW\" ? \"New South Wales\" : datum.country == \"VIC\" ? \"Victoria\" : datum.country == \"QLD\" ? \"Queensland\" : datum.country == \"WA\" ? \"Western Australia\" : datum.country == \"SA\" ? \"South Australia\" : datum.country == \"ACT\" ? \"Australian Capital Territory\" : datum.country == \"NT\" ? \"Northern Territory\" : datum.country == \"TAS\" ? \"Tasmania\" : datum.country",
          "as": "country_full"
        }
      ]
    },
    {
      "transform": [
        {
          "filter": "focus == 'All markets' ? (datum.country == 'Malaysia' || datum.spend == datum.max_spend || datum.visitors == datum.max_trips) : datum.country == focus"
        },
        {
          "calculate": "datum.country == \"USA\" ? \"United States\" : datum.country == \"UK\" ? \"United Kingdom\" : datum.country == \"NSW\" ? \"New South Wales\" : datum.country == \"VIC\" ? \"Victoria\" : datum.country == \"QLD\" ? \"Queensland\" : datum.country == \"WA\" ? \"Western Australia\" : datum.country == \"SA\" ? \"South Australia\" : datum.country == \"ACT\" ? \"Australian Capital Territory\" : datum.country == \"NT\" ? \"Northern Territory\" : datum.country == \"TAS\" ? \"Tasmania\" : datum.country",
          "as": "country_name"
        },
        {
          "calculate": "datum.country == \"USA\" ? \"United States\" : datum.country == \"UK\" ? \"United Kingdom\" : datum.country == \"NSW\" ? \"New South Wales\" : datum.country == \"VIC\" ? \"Victoria\" : datum.country == \"QLD\" ? \"Queensland\" : datum.country == \"WA\" ? \"Western Australia\" : datum.country == \"SA\" ? \"South Australia\" : datum.country == \"ACT\" ? \"Australian Capital Territory\" : datum.country == \"NT\" ? \"Northern Territory\" : datum.country == \"TAS\" ? \"Tasmania\" : datum.country",
          "as": "country_full"
        }
      ],
      "mark": {
        "type": "text",
        "dx": {
          "expr": "datum.visitors > (marketScale == 'Smaller markets' ? 25000 : 130000) ? -7 : 7"
        },
        "dy": -9,
        "align": {
          "expr": "datum.visitors > (marketScale == 'Smaller markets' ? 25000 : 130000) ? 'right' : 'left'"
        },
        "fontSize": 15,
        "color": "#162B4D",
        "cursor": "pointer"
      },
      "encoding": {
        "x": {
          "field": "visitors",
          "type": "quantitative"
        },
        "y": {
          "field": "spend",
          "type": "quantitative"
        },
        "text": {
          "field": "country_name",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "country_full",
            "type": "nominal",
            "title": "Origin"
          },
          {
            "field": "visitors",
            "type": "quantitative",
            "title": "Visitor trips",
            "format": ",.0f"
          },
          {
            "field": "spend",
            "type": "quantitative",
            "title": "Spending (Australian dollars)",
            "format": "$,.0f"
          }
        ]
      }
    }
  ]
}
