{
  "width": "container",
  "height": 380,
  "config": {
    "font": "IBM Plex Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "gridColor": "#DFE6EE",
      "domain": false,
      "tickColor": "#B3C2D3",
      "labelColor": "#000000",
      "titleColor": "#162B4D",
      "titlePadding": 14,
      "labelLimit": 150,
      "labelPadding": 7,
      "labelOverlap": true
    },
    "legend": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "orient": "bottom",
      "title": null,
      "labelLimit": 240
    },
    "title": {
      "fontSize": 16,
      "anchor": "start",
      "color": "#162B4D",
      "lineHeight": 20
    },
    "text": {
      "fontSize": 16,
      "lineHeight": 20,
      "color": "#162B4D"
    }
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0,
      0
    ],
    "center": [
      0,
      -28
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1,
        "cursor": "pointer"
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "properties.spend_per_resident",
            "type": "quantitative",
            "title": "AUD per resident",
            "format": "$,.0f"
          },
          {
            "field": "properties.spend",
            "type": "quantitative",
            "title": "Spending (AUD)",
            "format": "$,.0f"
          },
          {
            "field": "properties.population",
            "type": "quantitative",
            "title": "Residents",
            "format": ",.0f"
          }
        ],
        "color": {
          "field": "spending_band",
          "type": "ordinal",
          "scale": {
            "domain": [
              "Below $550",
              "$550–<600",
              "$600–<650",
              "$650–<1,000",
              "$1,000–<1,300",
              "$1,300+"
            ],
            "range": [
              "#EDEDED",
              "#C9C9C9",
              "#A6A6A6",
              "#808080",
              "#595959",
              "#262626"
            ]
          },
          "legend": {
            "title": "AUD per resident",
            "symbolType": "square",
            "columns": 2,
            "direction": "vertical",
            "rowPadding": 6,
            "columnPadding": 22,
            "labelLimit": 180
          }
        },
        "stroke": {
          "condition": {
            "test": "datum.properties.code == mapFocus",
            "value": "#000000"
          },
          "value": "#ffffff"
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.properties.code == mapFocus",
            "value": 3
          },
          "value": 1
        }
      },
      "transform": [
        {
          "calculate": "datum.properties.spend_per_resident < 550 ? \"Below $550\" : datum.properties.spend_per_resident < 600 ? \"$550\\u2013<600\" : datum.properties.spend_per_resident < 650 ? \"$600\\u2013<650\" : datum.properties.spend_per_resident < 1000 ? \"$650\\u2013<1,000\" : datum.properties.spend_per_resident < 1300 ? \"$1,000\\u2013<1,300\" : \"$1,300+\"",
          "as": "spending_band"
        }
      ]
    },
    {
      "data": {
        "url": "data/states.json"
      },
      "mark": {
        "type": "text",
        "fontWeight": "bold",
        "fontSize": 15,
        "color": "#162B4D",
        "lineBreak": "\n",
        "lineHeight": 18,
        "align": "center",
        "dx": -5,
        "dy": -16
      },
      "encoding": {
        "longitude": {
          "field": "label_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "label_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "map_label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.code == 'NT'",
            "value": "white"
          },
          "value": "#162B4D"
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "spend_per_resident",
            "type": "quantitative",
            "title": "AUD per resident",
            "format": "$,.0f"
          }
        ]
      },
      "transform": [
        {
          "filter": "datum.code == 'NT'"
        },
        {
          "calculate": "datum.code == 'NT' ? 'Northern\\nTerritory\\n$' + format(datum.spend_per_resident, ',.0f') : 'Australian\\nCapital Territory\\n$' + format(datum.spend_per_resident, ',.0f')",
          "as": "map_label"
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "longitude": 148.983,
            "latitude": -35.4618,
            "lon2": 158,
            "lat2": -42.5
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#162B4D",
        "strokeWidth": 1.4
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon2"
        },
        "latitude2": {
          "field": "lat2"
        }
      }
    },
    {
      "data": {
        "url": "data/states.json"
      },
      "mark": {
        "type": "circle",
        "filled": false,
        "size": 70,
        "stroke": "#162B4D",
        "strokeWidth": 1.6,
        "opacity": 1
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "stroke": {
          "condition": {
            "test": "mapFocus == 'ACT'",
            "value": "#000000"
          },
          "value": "#162B4D"
        },
        "strokeWidth": {
          "condition": {
            "test": "mapFocus == 'ACT'",
            "value": 3
          },
          "value": 1.6
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "spend_per_resident",
            "type": "quantitative",
            "title": "AUD per resident",
            "format": "$,.0f"
          }
        ]
      },
      "transform": [
        {
          "filter": "datum.code == 'ACT'"
        }
      ]
    },
    {
      "data": {
        "url": "data/states.json"
      },
      "transform": [
        {
          "filter": "datum.code == 'ACT'"
        },
        {
          "calculate": "'Australian Capital\\nTerritory\\n$' + format(datum.spend_per_resident, ',.0f')",
          "as": "callout"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "top",
        "dx": 0,
        "dy": 7,
        "fontSize": 15,
        "fontWeight": "bold",
        "lineBreak": "\n",
        "lineHeight": 18,
        "color": "#162B4D"
      },
      "encoding": {
        "longitude": {
          "datum": 158
        },
        "latitude": {
          "datum": -42.5
        },
        "text": {
          "field": "callout"
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "spend_per_resident",
            "type": "quantitative",
            "title": "AUD per resident",
            "format": "$,.0f"
          }
        ]
      }
    }
  ],
  "params": [
    {
      "name": "mapFocus",
      "value": ""
    }
  ]
}
