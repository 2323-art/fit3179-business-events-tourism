{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 560,
  "height": 580,
  "padding": 0,
  "autosize": "none",
  "data": [
    {
      "name": "tree",
      "url": "data/regions.json",
      "transform": [
        {
          "type": "joinaggregate",
          "groupby": [
            "parent"
          ],
          "fields": [
            "value"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "state_total"
          ]
        },
        {
          "type": "formula",
          "expr": "datum.value > 0 ? datum.value / datum.state_total : 0",
          "as": "state_share"
        },
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "value",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "method": "squarify",
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ],
          "paddingInner": 3,
          "paddingOuter": 3,
          "paddingTop": 22
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "!datum.children"
        }
      ]
    },
    {
      "name": "state_totals",
      "source": "leaves",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "parent"
          ],
          "fields": [
            "value"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "displayed_total"
          ]
        }
      ]
    },
    {
      "name": "parents",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth == 1"
        },
        {
          "type": "lookup",
          "from": "state_totals",
          "key": "parent",
          "fields": [
            "id"
          ],
          "values": [
            "displayed_total"
          ],
          "as": [
            "displayed_total"
          ]
        }
      ]
    },
    {
      "name": "labelled",
      "source": "leaves",
      "transform": [
        {
          "type": "formula",
          "expr": "datum.name == 'ACT (all)' ? 'Whole territory' : datum.name == 'Hobart & south' ? 'Hobart & south' : replace(datum.name, 'Regional ', 'Regional\\n')",
          "as": "label_text"
        },
        {
          "type": "formula",
          "expr": "length(split(datum.label_text, '\\n'))",
          "as": "label_lines"
        },
        {
          "type": "filter",
          "expr": "datum.y1-datum.y0 > datum.label_lines*17+12 && datum.x1-datum.x0 > max(length(split(datum.label_text,'\\n')[0]), length(split(datum.label_text,'\\n')[1] || ''))*7.5+14"
        }
      ]
    },
    {
      "name": "value_labelled",
      "source": "labelled",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.y1-datum.y0 > datum.label_lines*17+52 && datum.x1-datum.x0 > 104"
        }
      ]
    },
    {
      "name": "group_labels",
      "source": "parents",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.x1-datum.x0 > 35 && datum.y1-datum.y0 > 28"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "stateColour",
      "type": "ordinal",
      "domain": [
        "NSW",
        "VIC",
        "QLD",
        "WA",
        "SA",
        "ACT",
        "NT",
        "TAS"
      ],
      "range": [
        "#443675",
        "#795637",
        "#748128",
        "#D2BA68",
        "#5E608B",
        "#386453",
        "#9A8468",
        "#4F7F91"
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "parents"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "value": "#EDF1F6"
          },
          "stroke": {
            "signal": "stateFocus == datum.id ? '#162B4D' : '#FFFFFF'"
          },
          "strokeWidth": {
            "signal": "stateFocus == datum.id ? 2 : 1"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "scale": "stateColour",
            "field": "parent"
          },
          "tooltip": {
            "signal": "{'Destination':datum.name == 'ACT (all)' ? 'Whole ACT (no split available)' : datum.name,'State or territory':datum.parent,'Spending (AUD)':format(datum.value,',.0f'),'Share of displayed state spending':format(datum.state_share,'.1%'),'Displayed state total (AUD)':format(datum.state_total,',.0f')}"
          },
          "description": {
            "signal": "datum.name + ': AUD ' + format(datum.value / 1e6, ',.0f') + 'm; ' + format(datum.state_share, '.1%') + ' of displayed state spending'"
          }
        },
        "update": {
          "fillOpacity": {
            "signal": "stateFocus == 'All states' || datum.parent == stateFocus || datum.id == destinationFocus ? 1 : .25"
          },
          "cursor": {
            "value": "pointer"
          }
        }
      },
      "name": "destination_tiles"
    },
    {
      "type": "text",
      "from": {
        "data": "labelled"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0+4"
          },
          "y": {
            "signal": "datum.y0+18"
          },
          "text": {
            "field": "label_text"
          },
          "opacity": {
            "signal": "stateFocus == 'All states' || datum.parent == stateFocus || datum.id == destinationFocus ? 1 : .65"
          },
          "font": {
            "value": "IBM Plex Sans"
          },
          "fontSize": {
            "value": 14
          },
          "fill": {
            "signal": "indexof(['QLD','WA','NT'], datum.parent) >= 0 ? '#101820' : '#FFFFFF'"
          },
          "lineBreak": {
            "value": "\n"
          },
          "lineHeight": {
            "value": 17
          },
          "limit": {
            "signal": "datum.x1-datum.x0-8"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "value_labelled"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0+4"
          },
          "y": {
            "signal": "datum.y0+datum.label_lines*17+22"
          },
          "text": {
            "signal": "'AUD ' + format(datum.value/1e6, ',.0f') + 'm\\n' + format(datum.state_share, '.1%') + ' of state'"
          },
          "opacity": {
            "signal": "stateFocus == 'All states' || datum.parent == stateFocus || datum.id == destinationFocus ? 1 : .65"
          },
          "font": {
            "value": "IBM Plex Sans"
          },
          "fontSize": {
            "value": 14
          },
          "fill": {
            "signal": "indexof(['QLD','WA','NT'], datum.parent) >= 0 ? '#101820' : '#FFFFFF'"
          },
          "lineBreak": {
            "value": "\n"
          },
          "lineHeight": {
            "value": 17
          },
          "limit": {
            "signal": "datum.x1-datum.x0-8"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "group_labels"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0+5"
          },
          "y": {
            "signal": "datum.y0+15"
          },
          "text": {
            "field": "id"
          },
          "font": {
            "value": "IBM Plex Sans"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#162B4D"
          },
          "limit": {
            "signal": "datum.x1-datum.x0-10"
          },
          "tooltip": {
            "signal": "{'State or territory':datum.id,'Displayed spending (AUD)':format(datum.displayed_total,',.0f')}"
          }
        }
      }
    },
    {
      "name": "destination_outline",
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "interactive": false,
      "aria": false,
      "encode": {
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "value": "transparent"
          },
          "stroke": {
            "value": "#000000"
          },
          "strokeWidth": {
            "signal": "datum.id == destinationFocus ? 3 : 0"
          }
        }
      }
    }
  ],
  "signals": [
    {
      "name": "stateFocus",
      "value": "All states"
    },
    {
      "name": "destinationFocus",
      "value": ""
    }
  ],
  "description": "2025 business-event visitor spending by state and destination. Rectangle area represents AUD spending, not within-state share. State groups retain the existing colours; exact amounts and within-state shares are available in tooltips and the selected-state detail."
}
