{
  "width": "container",
  "height": 420,
  "config": {
    "font": "IBM Plex Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "gridColor": "#DFE6EE",
      "domain": false,
      "tickColor": "#B3C2D3",
      "labelColor": "#162B4D",
      "titleColor": "#162B4D",
      "titlePadding": 12,
      "labelLimit": 150
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "orient": "bottom",
      "title": null
    },
    "title": {
      "fontSize": 14,
      "anchor": "start",
      "color": "#162B4D"
    }
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/changes.json"
  },
  "encoding": {
    "x": {
      "field": "metric",
      "type": "ordinal",
      "sort": [
        "Visitors",
        "Nights",
        "Spend"
      ],
      "title": null,
      "axis": {
        "orient": "top",
        "labelAngle": 0
      }
    },
    "y": {
      "field": "country",
      "type": "nominal",
      "sort": [
        "China",
        "Malaysia",
        "India",
        "New Zealand",
        "Korea",
        "UK",
        "Germany",
        "Philippines",
        "Scandinavia",
        "Hong Kong",
        "France",
        "USA",
        "Singapore",
        "Japan",
        "Indonesia",
        "Canada",
        "Netherlands",
        "Viet Nam"
      ],
      "title": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "color": {
          "field": "change",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.65,
              0,
              0.65
            ],
            "range": [
              "#915114",
              "#FFFFFF",
              "#2457D6"
            ],
            "clamp": true,
            "interpolate": "rgb"
          },
          "legend": {
            "title": "Change, 2024 → 2025",
            "format": "+.0%",
            "gradientLength": 190
          }
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal"
          },
          {
            "field": "metric",
            "type": "nominal"
          },
          {
            "field": "change",
            "type": "quantitative",
            "title": "Change",
            "format": "+.1%"
          },
          {
            "field": "before",
            "type": "quantitative",
            "title": "2024",
            "format": ",.0f"
          },
          {
            "field": "after",
            "type": "quantitative",
            "title": "2025",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.country == 'Malaysia'"
        }
      ],
      "mark": {
        "type": "rect",
        "fillOpacity": 0,
        "stroke": "#007F78",
        "strokeWidth": 2
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12
      },
      "encoding": {
        "text": {
          "field": "change_label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "abs(datum.change) > 0.48",
            "value": "white"
          },
          "value": "#162B4D"
        }
      }
    }
  ],
  "transform": [
    {
      "calculate": "abs(datum.change) < 0.0005 ? '0.0%' : format(datum.change, '+.1%')",
      "as": "change_label"
    }
  ]
}