{
  "width": "container",
  "height": 520,
  "config": {
    "font": "IBM Plex Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "gridColor": "#DFE6EE",
      "domain": false,
      "tickColor": "#B3C2D3",
      "labelColor": "#000000",
      "titleColor": "#162B4D",
      "titlePadding": 14,
      "labelLimit": 150,
      "labelPadding": 7,
      "labelOverlap": true
    },
    "legend": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "orient": "bottom",
      "title": null,
      "labelLimit": 240
    },
    "title": {
      "fontSize": 16,
      "anchor": "start",
      "color": "#162B4D",
      "lineHeight": 20
    },
    "text": {
      "fontSize": 16,
      "lineHeight": 20,
      "color": "#162B4D"
    }
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/changes.json"
  },
  "encoding": {
    "x": {
      "field": "metric",
      "type": "ordinal",
      "sort": [
        "Visitors",
        "Nights",
        "Spend"
      ],
      "title": null,
      "axis": {
        "orient": "top",
        "labelAngle": 0
      }
    },
    "y": {
      "field": "country",
      "type": "nominal",
      "sort": [
        "China",
        "Malaysia",
        "India",
        "New Zealand",
        "Korea",
        "UK",
        "Germany",
        "Philippines",
        "Scandinavia",
        "Hong Kong",
        "France",
        "USA",
        "Singapore",
        "Japan",
        "Indonesia",
        "Canada",
        "Netherlands",
        "Viet Nam"
      ],
      "title": null,
      "axis": {
        "labelExpr": "datum.label == \"USA\" ? \"United States\" : datum.label == \"UK\" ? \"United Kingdom\" : datum.label == \"NSW\" ? \"New South Wales\" : datum.label == \"VIC\" ? \"Victoria\" : datum.label == \"QLD\" ? \"Queensland\" : datum.label == \"WA\" ? \"Western Australia\" : datum.label == \"SA\" ? \"South Australia\" : datum.label == \"ACT\" ? \"Australian Capital Territory\" : datum.label == \"NT\" ? \"Northern Territory\" : datum.label == \"TAS\" ? \"Tasmania\" : datum.label",
        "labelLimit": 180
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 2,
        "cursor": "pointer"
      },
      "encoding": {
        "color": {
          "field": "change",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.65,
              0,
              0.65
            ],
            "range": [
              "#C45118",
              "#FFFFFF",
              "#762A83"
            ],
            "clamp": true,
            "interpolate": "rgb"
          },
          "legend": {
            "title": [
              "Change,",
              "2024 to 2025"
            ],
            "format": "+.0%",
            "gradientLength": 120
          }
        },
        "tooltip": [
          {
            "field": "country_full",
            "type": "nominal"
          },
          {
            "field": "metric",
            "type": "nominal"
          },
          {
            "field": "change",
            "type": "quantitative",
            "title": "Change",
            "format": "+.1%"
          },
          {
            "field": "before",
            "type": "quantitative",
            "title": "2024",
            "format": ",.0f"
          },
          {
            "field": "after",
            "type": "quantitative",
            "title": "2025",
            "format": ",.0f"
          }
        ]
      },
      "transform": [
        {
          "calculate": "datum.country == \"USA\" ? \"United States\" : datum.country == \"UK\" ? \"United Kingdom\" : datum.country == \"NSW\" ? \"New South Wales\" : datum.country == \"VIC\" ? \"Victoria\" : datum.country == \"QLD\" ? \"Queensland\" : datum.country == \"WA\" ? \"Western Australia\" : datum.country == \"SA\" ? \"South Australia\" : datum.country == \"ACT\" ? \"Australian Capital Territory\" : datum.country == \"NT\" ? \"Northern Territory\" : datum.country == \"TAS\" ? \"Tasmania\" : datum.country",
          "as": "country_full"
        }
      ]
    },
    {
      "transform": [
        {
          "filter": "datum.country == marketFocus"
        }
      ],
      "mark": {
        "type": "rect",
        "fillOpacity": 0,
        "stroke": "#162B4D",
        "strokeWidth": 3,
        "cursor": "pointer"
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 15,
        "cursor": "pointer"
      },
      "encoding": {
        "text": {
          "field": "change_label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "contrast('white', scale('color', datum.change)) > contrast('black', scale('color', datum.change))",
            "value": "white"
          },
          "value": "black"
        }
      },
      "transform": [
        {
          "filter": "datum.country == marketFocus"
        }
      ]
    }
  ],
  "transform": [
    {
      "calculate": "abs(datum.change) < 0.0005 ? '0.0%' : format(datum.change, '+.1%')",
      "as": "change_label"
    }
  ],
  "params": [
    {
      "name": "marketFocus",
      "value": "Malaysia"
    }
  ],
  "background": "transparent"
}
