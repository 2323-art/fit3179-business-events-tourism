{
  "width": "container",
  "height": 300,
  "config": {
    "font": "IBM Plex Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "gridColor": "#DFE6EE",
      "domain": false,
      "tickColor": "#B3C2D3",
      "labelColor": "#4E6078",
      "titleColor": "#162B4D",
      "titlePadding": 14,
      "labelLimit": 150,
      "tickCount": 5,
      "labelPadding": 7,
      "labelOverlap": true
    },
    "legend": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "orient": "bottom",
      "title": null,
      "labelLimit": 240
    },
    "title": {
      "fontSize": 16,
      "anchor": "start",
      "color": "#162B4D",
      "lineHeight": 20
    },
    "text": {
      "fontSize": 16,
      "lineHeight": 20,
      "color": "#162B4D"
    }
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/national.json"
  },
  "transform": [
    {
      "filter": "datum.year == 2025"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "x": {
          "field": "spend_per_trip",
          "type": "quantitative",
          "title": [
            "Spending per trip",
            "in Australian dollars"
          ],
          "axis": {
            "format": "$,.0f",
            "tickCount": 3
          },
          "scale": {
            "domain": [
              0,
              3800
            ]
          }
        },
        "y": {
          "field": "traveller",
          "type": "nominal",
          "sort": [
            "International",
            "Domestic overnight",
            "Domestic day"
          ],
          "title": null,
          "axis": {
            "labelExpr": "datum.label == 'Domestic overnight' ? ['Domestic', 'overnight'] : datum.label",
            "labelLineHeight": 18
          }
        },
        "color": {
          "field": "traveller",
          "type": "nominal",
          "scale": {
            "domain": [
              "Domestic day",
              "Domestic overnight",
              "International"
            ],
            "range": [
              "#B47716",
              "#007F78",
              "#2457D6"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "traveller",
            "type": "nominal"
          },
          {
            "field": "spend_per_trip",
            "type": "quantitative",
            "title": "Australian dollars per trip",
            "format": "$,.0f"
          }
        ]
      }
    }
  ]
}