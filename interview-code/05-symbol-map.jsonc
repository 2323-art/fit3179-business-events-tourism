// INTERVIEW COPY: 05-symbol-map.json
// Layer a neutral basemap, area-scaled circles, leader lines and labels. longitude/latitude place circles; size maps visits to symbol area, not radius. stateFocus fades unselected states.
// Read-only study companion. The website loads specs/05-symbol-map.json, not this .jsonc file.
// Comments explain this exact local snapshot; regenerate/recompare after future chart edits.
{
  "width": "container",
  "height": 360,
  // Shared presentation defaults for this chart: fonts, axes, gridlines, legends and text.
  "config": {
    "font": "IBM Plex Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "gridColor": "#DFE6EE",
      "domain": false,
      "tickColor": "#B3C2D3",
      "labelColor": "#4E6078",
      "titleColor": "#162B4D",
      "titlePadding": 14,
      "labelLimit": 150,
      "labelPadding": 7,
      "labelOverlap": true
    },
    "legend": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "orient": "bottom",
      "title": null,
      "labelLimit": 240
    },
    "title": {
      "fontSize": 16,
      "anchor": "start",
      "color": "#162B4D",
      "lineHeight": 20
    },
    "text": {
      "fontSize": 16,
      "lineHeight": 20,
      "color": "#162B4D"
    }
  },
  // Select the grammar/version: Vega-Lite is a high-level chart language; Vega gives direct control over dataflows and marks.
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  // Convert longitude/latitude into flat screen coordinates. Equal-area preserves relative area, not every shape or distance.
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0,
      0
    ],
    "center": [
      0,
      -28
    ]
  },
  // Draw these subviews on top of each other: earlier layers form the background; later layers add marks/labels.
  "layer": [
    {
      // Input observations, a named dataset reference, or inline annotation data. A URL is resolved relative to the site directory.
      "data": {
        "url": "data/australia.json",
        // Parsing or display formatting, depending on location: reading GeoJSON features or formatting readable numbers.
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      // Choose the primitive drawn for each record. Appearance can be constant here or driven by encoding below.
      "mark": {
        "type": "geoshape",
        "fill": "#EDF1F5",
        "stroke": "white"
      }
    },
    {
      // Input observations, a named dataset reference, or inline annotation data. A URL is resolved relative to the site directory.
      "data": {
        "url": "data/states.json"
      },
      // Choose the primitive drawn for each record. Appearance can be constant here or driven by encoding below.
      "mark": {
        "type": "circle",
        "fillOpacity": 1,
        // Line thickness. When a field is mapped here, its magnitude determines the visible width.
        "strokeWidth": 1.5
      },
      // Map data fields to visual channels. field selects a column; quantitative means magnitude, nominal means category.
      "encoding": {
        // Geographic horizontal coordinate, passed through the projection rather than treated as an ordinary chart x value.
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        // Geographic vertical coordinate, passed through the projection.
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "visitors",
          "type": "quantitative",
          // Map a data domain to a visual range. Explicit domains keep the frame stable across interactions.
          "scale": {
            "domain": [
              0,
              7500000
            ],
            "range": [
              0,
              4400
            ]
          },
          "legend": {
            "title": [
              "State visits",
              "(millions)"
            ],
            // Parsing or display formatting, depending on location: reading GeoJSON features or formatting readable numbers.
            "format": ",.0f",
            "values": [
              1000000,
              4000000,
              7000000
            ],
            "labelExpr": "format(datum.value / 1e6, '.0f')",
            "symbolFillColor": "#FFFFFF",
            "symbolStrokeColor": "#162B4D",
            "symbolStrokeWidth": 1.5
          }
        },
        // Fields or expressions displayed on hover; formats improve readability while preserving stored values.
        "tooltip": [
          {
            "field": "state",
            "type": "nominal"
          },
          {
            "field": "visitors",
            "type": "quantitative",
            "title": "State visits",
            // Parsing or display formatting, depending on location: reading GeoJSON features or formatting readable numbers.
            "format": ",.0f"
          }
        ],
        "color": {
          "field": "code",
          "type": "nominal",
          // Map a data domain to a visual range. Explicit domains keep the frame stable across interactions.
          "scale": {
            "domain": [
              "NSW",
              "VIC",
              "QLD",
              "WA",
              "SA",
              "ACT",
              "NT",
              "TAS"
            ],
            "range": [
              "#443675",
              "#795637",
              "#748128",
              "#D2BA68",
              "#5E608B",
              "#386453",
              "#9A8468",
              "#4F7F91"
            ]
          },
          "legend": null
        },
        // Transparency changes emphasis. It does not modify the recorded visitor or spending amount.
        "opacity": {
          // Choose a visual property based on a parameter/test, for example fade unselected markets while retaining context.
          "condition": {
            "test": "stateFocus == 'All states' || datum.code == stateFocus",
            "value": 1
          },
          "value": 0.18
        },
        "stroke": {
          "value": "#FFFFFF"
        },
        "order": {
          "field": "visitors",
          "type": "quantitative",
          "sort": "descending"
        }
      }
    },
    {
      // Input observations, a named dataset reference, or inline annotation data. A URL is resolved relative to the site directory.
      "data": {
        "url": "data/states.json"
      },
      // Apply these operations in order before drawing this view/layer. datum means the current record.
      "transform": [
        {
          // Keep records satisfying this expression; unlike opacity highlighting, filtering removes records from this view/layer.
          "filter": "stateFocus == 'All states' ? (datum.code == 'NSW' || (width >= 400 && (datum.code == 'QLD' || datum.code == 'VIC'))) : datum.code == stateFocus"
        },
        {
          // Compute a new field; the adjacent as key names the result. This often formats labels without changing raw values.
          "calculate": "datum.code == 'QLD' ? 153 : datum.code == 'NSW' ? 156 : datum.code == 'VIC' ? 137 : datum.code == 'ACT' ? 156 : datum.code == 'TAS' ? 137 : datum.longitude",
          "as": "story_lon"
        },
        {
          // Compute a new field; the adjacent as key names the result. This often formats labels without changing raw values.
          "calculate": "datum.code == 'QLD' ? -15 : datum.code == 'NSW' ? -27 : datum.code == 'VIC' ? -43 : datum.code == 'ACT' ? -33 : datum.code == 'TAS' ? -40 : datum.latitude - 5",
          "as": "story_lat"
        },
        {
          // Compute a new field; the adjacent as key names the result. This often formats labels without changing raw values.
          "calculate": "datum.code == 'NSW' ? 'New South\\nWales' : datum.code == 'ACT' ? 'Australian Capital\\nTerritory' : datum.state",
          "as": "story_name"
        },
        {
          // Compute a new field; the adjacent as key names the result. This often formats labels without changing raw values.
          "calculate": "datum.story_name + '\\n' + (datum.visitors >= 1e6 ? format(datum.visitors / 1e6, '.1f') + 'm' : format(datum.visitors, ',')) + ' visits'",
          "as": "story_label"
        }
      ],
      "name": "story_state_leaders",
      // Choose the primitive drawn for each record. Appearance can be constant here or driven by encoding below.
      "mark": {
        "type": "rule",
        "color": "#4E6078",
        // Line thickness. When a field is mapped here, its magnitude determines the visible width.
        "strokeWidth": 1
      },
      // Map data fields to visual channels. field selects a column; quantitative means magnitude, nominal means category.
      "encoding": {
        // Geographic horizontal coordinate, passed through the projection rather than treated as an ordinary chart x value.
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        // Geographic vertical coordinate, passed through the projection.
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "story_lon"
        },
        "latitude2": {
          "field": "story_lat"
        }
      }
    },
    {
      // Input observations, a named dataset reference, or inline annotation data. A URL is resolved relative to the site directory.
      "data": {
        "url": "data/states.json"
      },
      // Apply these operations in order before drawing this view/layer. datum means the current record.
      "transform": [
        {
          // Keep records satisfying this expression; unlike opacity highlighting, filtering removes records from this view/layer.
          "filter": "stateFocus == 'All states' ? (datum.code == 'NSW' || (width >= 400 && (datum.code == 'QLD' || datum.code == 'VIC'))) : datum.code == stateFocus"
        },
        {
          // Compute a new field; the adjacent as key names the result. This often formats labels without changing raw values.
          "calculate": "datum.code == 'QLD' ? 153 : datum.code == 'NSW' ? 156 : datum.code == 'VIC' ? 137 : datum.code == 'ACT' ? 156 : datum.code == 'TAS' ? 137 : datum.longitude",
          "as": "story_lon"
        },
        {
          // Compute a new field; the adjacent as key names the result. This often formats labels without changing raw values.
          "calculate": "datum.code == 'QLD' ? -15 : datum.code == 'NSW' ? -27 : datum.code == 'VIC' ? -43 : datum.code == 'ACT' ? -33 : datum.code == 'TAS' ? -40 : datum.latitude - 5",
          "as": "story_lat"
        },
        {
          // Compute a new field; the adjacent as key names the result. This often formats labels without changing raw values.
          "calculate": "datum.code == 'NSW' ? 'New South\\nWales' : datum.code == 'ACT' ? 'Australian Capital\\nTerritory' : datum.state",
          "as": "story_name"
        },
        {
          // Compute a new field; the adjacent as key names the result. This often formats labels without changing raw values.
          "calculate": "datum.story_name + '\\n' + (datum.visitors >= 1e6 ? format(datum.visitors / 1e6, '.1f') + 'm' : format(datum.visitors, ',')) + ' visits'",
          "as": "story_label"
        }
      ],
      "name": "story_state_labels",
      // Choose the primitive drawn for each record. Appearance can be constant here or driven by encoding below.
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": 600,
        "lineHeight": 17,
        "lineBreak": "\n",
        "align": "center",
        "baseline": "top",
        "dy": {
          "expr": "datum.code == 'NSW' || datum.code == 'ACT' ? -59 : datum.code == 'QLD' || datum.code == 'TAS' ? -42 : 6"
        },
        "color": "#162B4D"
      },
      // Map data fields to visual channels. field selects a column; quantitative means magnitude, nominal means category.
      "encoding": {
        // Geographic horizontal coordinate, passed through the projection rather than treated as an ordinary chart x value.
        "longitude": {
          "field": "story_lon",
          "type": "quantitative"
        },
        // Geographic vertical coordinate, passed through the projection.
        "latitude": {
          "field": "story_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "story_label"
        }
      }
    }
  ],
  // Interactive values. bind connects a parameter to an HTML control; app.js can also update the resulting signal.
  "params": [
    {
      "name": "stateFocus",
      "value": "All states"
    }
  ]
}
