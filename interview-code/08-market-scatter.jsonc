// INTERVIEW COPY: 08-market-scatter.json
// Filter by year; circle x=visitors, y=spend, with fixed axis domains. focus fades other markets. joinaggregate appends leaders to each row so the label layer can identify maxima without collapsing the data.
// Read-only study companion. The website loads specs/08-market-scatter.json, not this .jsonc file.
// Comments explain this exact local snapshot; regenerate/recompare after future chart edits.
{
  "width": "container",
  "height": 360,
  // Shared presentation defaults for this chart: fonts, axes, gridlines, legends and text.
  "config": {
    "font": "IBM Plex Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "gridColor": "#DFE6EE",
      "domain": false,
      "tickColor": "#B3C2D3",
      "labelColor": "#4E6078",
      "titleColor": "#162B4D",
      "titlePadding": 14,
      "labelLimit": 150,
      "tickCount": 5,
      "labelPadding": 7,
      "labelOverlap": true
    },
    "legend": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "orient": "bottom",
      "title": null,
      "labelLimit": 240
    },
    "title": {
      "fontSize": 16,
      "anchor": "start",
      "color": "#162B4D",
      "lineHeight": 20
    },
    "text": {
      "fontSize": 16,
      "lineHeight": 20,
      "color": "#162B4D"
    }
  },
  // Select the grammar/version: Vega-Lite is a high-level chart language; Vega gives direct control over dataflows and marks.
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  // Input observations, a named dataset reference, or inline annotation data. A URL is resolved relative to the site directory.
  "data": {
    "url": "data/markets.json"
  },
  // Interactive values. bind connects a parameter to an HTML control; app.js can also update the resulting signal.
  "params": [
    {
      "name": "year",
      "value": 2025,
      // Generate a control such as a dropdown. A changed selection updates the parameter used by filters or conditions.
      "bind": {
        "input": "select",
        "options": [
          2024,
          2025
        ],
        "name": "Year: "
      }
    },
    {
      "name": "focus",
      "value": "All markets",
      // Generate a control such as a dropdown. A changed selection updates the parameter used by filters or conditions.
      "bind": {
        "input": "select",
        "options": [
          "All markets",
          "Canada",
          "China",
          "France",
          "Germany",
          "Hong Kong",
          "India",
          "Indonesia",
          "Japan",
          "Korea",
          "Malaysia",
          "Netherlands",
          "New Zealand",
          "Philippines",
          "Scandinavia",
          "Singapore",
          "UK",
          "USA",
          "Viet Nam"
        ],
        "name": "Highlight: ",
        "labels": [
          "All markets",
          "Canada",
          "China",
          "France",
          "Germany",
          "Hong Kong",
          "India",
          "Indonesia",
          "Japan",
          "Korea",
          "Malaysia",
          "Netherlands",
          "New Zealand",
          "Philippines",
          "Scandinavia",
          "Singapore",
          "United Kingdom",
          "United States",
          "Viet Nam"
        ]
      }
    }
  ],
  // Apply these operations in order before drawing this view/layer. datum means the current record.
  "transform": [
    {
      // Keep records satisfying this expression; unlike opacity highlighting, filtering removes records from this view/layer.
      "filter": "datum.year == year"
    },
    {
      // Compute summary values and attach them to every input row, retaining the individual observations.
      "joinaggregate": [
        {
          "op": "max",
          "field": "spend",
          "as": "max_spend"
        },
        {
          "op": "max",
          "field": "visitors",
          "as": "max_trips"
        }
      ]
    }
  ],
  // Draw these subviews on top of each other: earlier layers form the background; later layers add marks/labels.
  "layer": [
    {
      // Choose the primitive drawn for each record. Appearance can be constant here or driven by encoding below.
      "mark": {
        "type": "circle",
        "size": 110,
        "stroke": "white",
        // Line thickness. When a field is mapped here, its magnitude determines the visible width.
        "strokeWidth": 1
      },
      // Map data fields to visual channels. field selects a column; quantitative means magnitude, nominal means category.
      "encoding": {
        "x": {
          "field": "visitors",
          "type": "quantitative",
          "title": "Visitor trips",
          "axis": {
            // Parsing or display formatting, depending on location: reading GeoJSON features or formatting readable numbers.
            "format": ",.0f",
            "tickCount": 3
          },
          // Map a data domain to a visual range. Explicit domains keep the frame stable across interactions.
          "scale": {
            "domain": [
              0,
              185000
            ]
          }
        },
        "y": {
          "field": "spend",
          "type": "quantitative",
          "title": [
            "Spending in Australia",
            "(AUD millions)"
          ],
          "axis": {
            "labelExpr": "format(datum.value / 1e6, '.0f')",
            "tickCount": 4
          },
          // Map a data domain to a visual range. Explicit domains keep the frame stable across interactions.
          "scale": {
            "domain": [
              0,
              400000000
            ]
          }
        },
        "color": {
          "value": "#2457D6"
        },
        // Transparency changes emphasis. It does not modify the recorded visitor or spending amount.
        "opacity": {
          // Choose a visual property based on a parameter/test, for example fade unselected markets while retaining context.
          "condition": {
            "test": "focus == 'All markets' || datum.country == focus",
            "value": 0.85
          },
          "value": 0.12
        },
        // Fields or expressions displayed on hover; formats improve readability while preserving stored values.
        "tooltip": [
          {
            "field": "country_full",
            "type": "nominal",
            "title": "Origin"
          },
          {
            "field": "visitors",
            "type": "quantitative",
            "title": "Visitor trips",
            // Parsing or display formatting, depending on location: reading GeoJSON features or formatting readable numbers.
            "format": ",.0f"
          },
          {
            "field": "spend",
            "type": "quantitative",
            "title": "Spending (Australian dollars)",
            // Parsing or display formatting, depending on location: reading GeoJSON features or formatting readable numbers.
            "format": "$,.0f"
          }
        ]
      },
      // Apply these operations in order before drawing this view/layer. datum means the current record.
      "transform": [
        {
          // Compute a new field; the adjacent as key names the result. This often formats labels without changing raw values.
          "calculate": "datum.country == \"USA\" ? \"United States\" : datum.country == \"UK\" ? \"United Kingdom\" : datum.country == \"NSW\" ? \"New South Wales\" : datum.country == \"VIC\" ? \"Victoria\" : datum.country == \"QLD\" ? \"Queensland\" : datum.country == \"WA\" ? \"Western Australia\" : datum.country == \"SA\" ? \"South Australia\" : datum.country == \"ACT\" ? \"Australian Capital Territory\" : datum.country == \"NT\" ? \"Northern Territory\" : datum.country == \"TAS\" ? \"Tasmania\" : datum.country",
          "as": "country_full"
        }
      ]
    },
    {
      // Apply these operations in order before drawing this view/layer. datum means the current record.
      "transform": [
        {
          // Keep records satisfying this expression; unlike opacity highlighting, filtering removes records from this view/layer.
          "filter": "focus == 'All markets' ? (datum.country == 'Malaysia' || datum.spend == datum.max_spend || datum.visitors == datum.max_trips) : datum.country == focus"
        },
        {
          // Compute a new field; the adjacent as key names the result. This often formats labels without changing raw values.
          "calculate": "datum.country == \"USA\" ? \"United States\" : datum.country == \"UK\" ? \"United Kingdom\" : datum.country == \"NSW\" ? \"New South Wales\" : datum.country == \"VIC\" ? \"Victoria\" : datum.country == \"QLD\" ? \"Queensland\" : datum.country == \"WA\" ? \"Western Australia\" : datum.country == \"SA\" ? \"South Australia\" : datum.country == \"ACT\" ? \"Australian Capital Territory\" : datum.country == \"NT\" ? \"Northern Territory\" : datum.country == \"TAS\" ? \"Tasmania\" : datum.country",
          "as": "country_name"
        },
        {
          // Compute a new field; the adjacent as key names the result. This often formats labels without changing raw values.
          "calculate": "datum.country == \"USA\" ? \"United States\" : datum.country == \"UK\" ? \"United Kingdom\" : datum.country == \"NSW\" ? \"New South Wales\" : datum.country == \"VIC\" ? \"Victoria\" : datum.country == \"QLD\" ? \"Queensland\" : datum.country == \"WA\" ? \"Western Australia\" : datum.country == \"SA\" ? \"South Australia\" : datum.country == \"ACT\" ? \"Australian Capital Territory\" : datum.country == \"NT\" ? \"Northern Territory\" : datum.country == \"TAS\" ? \"Tasmania\" : datum.country",
          "as": "country_full"
        }
      ],
      // Choose the primitive drawn for each record. Appearance can be constant here or driven by encoding below.
      "mark": {
        "type": "text",
        "dx": {
          "expr": "datum.visitors > 130000 ? -7 : 7"
        },
        "dy": -9,
        "align": {
          "expr": "datum.visitors > 130000 ? 'right' : 'left'"
        },
        "fontSize": 15,
        "color": "#162B4D"
      },
      // Map data fields to visual channels. field selects a column; quantitative means magnitude, nominal means category.
      "encoding": {
        "x": {
          "field": "visitors",
          "type": "quantitative"
        },
        "y": {
          "field": "spend",
          "type": "quantitative"
        },
        "text": {
          "field": "country_name",
          "type": "nominal"
        },
        // Fields or expressions displayed on hover; formats improve readability while preserving stored values.
        "tooltip": [
          {
            "field": "country_full",
            "type": "nominal",
            "title": "Origin"
          },
          {
            "field": "visitors",
            "type": "quantitative",
            "title": "Visitor trips",
            // Parsing or display formatting, depending on location: reading GeoJSON features or formatting readable numbers.
            "format": ",.0f"
          },
          {
            "field": "spend",
            "type": "quantitative",
            "title": "Spending (Australian dollars)",
            // Parsing or display formatting, depending on location: reading GeoJSON features or formatting readable numbers.
            "format": "$,.0f"
          }
        ]
      }
    }
  ]
}
