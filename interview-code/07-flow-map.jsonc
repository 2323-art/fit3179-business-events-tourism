// INTERVIEW COPY: 07-flow-map.json
// A world geoshape basemap plus GeoJSON LineString routes prepared in Python. strokeWidth encodes visitors; these are schematic capital-to-capital connections. originFocus changes emphasis, not the data values.
// Read-only study companion. The website loads specs/07-flow-map.json, not this .jsonc file.
// Comments explain this exact local snapshot; regenerate/recompare after future chart edits.
{
  "width": "container",
  "height": 440,
  // Shared presentation defaults for this chart: fonts, axes, gridlines, legends and text.
  "config": {
    "font": "IBM Plex Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "gridColor": "#DFE6EE",
      "domain": false,
      "tickColor": "#B3C2D3",
      "labelColor": "#4E6078",
      "titleColor": "#162B4D",
      "titlePadding": 14,
      "labelLimit": 150,
      "labelPadding": 7,
      "labelOverlap": true
    },
    "legend": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "orient": "bottom",
      "title": null,
      "labelLimit": 240
    },
    "title": {
      "fontSize": 16,
      "anchor": "start",
      "color": "#162B4D",
      "lineHeight": 20
    },
    "text": {
      "fontSize": 16,
      "lineHeight": 20,
      "color": "#162B4D"
    }
  },
  // Select the grammar/version: Vega-Lite is a high-level chart language; Vega gives direct control over dataflows and marks.
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  // Convert longitude/latitude into flat screen coordinates. Equal-area preserves relative area, not every shape or distance.
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -150,
      0,
      0
    ]
  },
  // Draw these subviews on top of each other: earlier layers form the background; later layers add marks/labels.
  "layer": [
    {
      // Input observations, a named dataset reference, or inline annotation data. A URL is resolved relative to the site directory.
      "data": {
        "url": "data/world.json",
        // Parsing or display formatting, depending on location: reading GeoJSON features or formatting readable numbers.
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      // Choose the primitive drawn for each record. Appearance can be constant here or driven by encoding below.
      "mark": {
        "type": "geoshape",
        "fill": "#E8EFF5",
        "stroke": "white",
        // Line thickness. When a field is mapped here, its magnitude determines the visible width.
        "strokeWidth": 0.5
      }
    },
    {
      // Input observations, a named dataset reference, or inline annotation data. A URL is resolved relative to the site directory.
      "data": {
        "url": "data/routes.json",
        // Parsing or display formatting, depending on location: reading GeoJSON features or formatting readable numbers.
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      // Choose the primitive drawn for each record. Appearance can be constant here or driven by encoding below.
      "mark": {
        "type": "geoshape",
        "filled": false,
        "strokeOpacity": 1
      },
      // Map data fields to visual channels. field selects a column; quantitative means magnitude, nominal means category.
      "encoding": {
        // Line thickness. When a field is mapped here, its magnitude determines the visible width.
        "strokeWidth": {
          "field": "properties.visitors",
          "type": "quantitative",
          // Map a data domain to a visual range. Explicit domains keep the frame stable across interactions.
          "scale": {
            "domain": [
              0,
              165000
            ],
            "range": [
              0,
              12
            ]
          },
          "legend": {
            "title": "Visitor trips",
            "values": [
              50000,
              100000,
              150000
            ],
            // Parsing or display formatting, depending on location: reading GeoJSON features or formatting readable numbers.
            "format": ",.0f",
            "symbolType": "stroke",
            "symbolSize": 700,
            "symbolStrokeColor": "#2457D6"
          }
        },
        "stroke": {
          "value": "#2457D6"
        },
        // Fields or expressions displayed on hover; formats improve readability while preserving stored values.
        "tooltip": [
          {
            "field": "country_full",
            "type": "nominal",
            "title": "Origin"
          },
          {
            "field": "properties.visitors",
            "type": "quantitative",
            "title": "Visitor trips",
            // Parsing or display formatting, depending on location: reading GeoJSON features or formatting readable numbers.
            "format": ",.0f"
          }
        ],
        // Transparency changes emphasis. It does not modify the recorded visitor or spending amount.
        "opacity": {
          // Choose a visual property based on a parameter/test, for example fade unselected markets while retaining context.
          "condition": {
            "test": "originFocus == 'All origins' || datum.properties.country == originFocus",
            "value": 0.8
          },
          "value": 0.1
        }
      },
      // Apply these operations in order before drawing this view/layer. datum means the current record.
      "transform": [
        {
          // Compute a new field; the adjacent as key names the result. This often formats labels without changing raw values.
          "calculate": "datum.properties.country == \"USA\" ? \"United States\" : datum.properties.country == \"UK\" ? \"United Kingdom\" : datum.properties.country == \"NSW\" ? \"New South Wales\" : datum.properties.country == \"VIC\" ? \"Victoria\" : datum.properties.country == \"QLD\" ? \"Queensland\" : datum.properties.country == \"WA\" ? \"Western Australia\" : datum.properties.country == \"SA\" ? \"South Australia\" : datum.properties.country == \"ACT\" ? \"Australian Capital Territory\" : datum.properties.country == \"NT\" ? \"Northern Territory\" : datum.properties.country == \"TAS\" ? \"Tasmania\" : datum.properties.country",
          "as": "country_full"
        }
      ]
    },
    {
      // Input observations, a named dataset reference, or inline annotation data. A URL is resolved relative to the site directory.
      "data": {
        "url": "data/origins.json"
      },
      // Choose the primitive drawn for each record. Appearance can be constant here or driven by encoding below.
      "mark": {
        "type": "circle",
        "size": 50,
        "color": "#162B4D"
      },
      // Map data fields to visual channels. field selects a column; quantitative means magnitude, nominal means category.
      "encoding": {
        // Geographic horizontal coordinate, passed through the projection rather than treated as an ordinary chart x value.
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        // Geographic vertical coordinate, passed through the projection.
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        // Fields or expressions displayed on hover; formats improve readability while preserving stored values.
        "tooltip": [
          {
            "field": "country_full",
            "type": "nominal",
            "title": "Origin"
          },
          {
            "field": "visitors",
            "type": "quantitative",
            "title": "Visitor trips",
            // Parsing or display formatting, depending on location: reading GeoJSON features or formatting readable numbers.
            "format": ",.0f"
          }
        ]
      },
      // Apply these operations in order before drawing this view/layer. datum means the current record.
      "transform": [
        {
          // Compute a new field; the adjacent as key names the result. This often formats labels without changing raw values.
          "calculate": "datum.country == \"USA\" ? \"United States\" : datum.country == \"UK\" ? \"United Kingdom\" : datum.country == \"NSW\" ? \"New South Wales\" : datum.country == \"VIC\" ? \"Victoria\" : datum.country == \"QLD\" ? \"Queensland\" : datum.country == \"WA\" ? \"Western Australia\" : datum.country == \"SA\" ? \"South Australia\" : datum.country == \"ACT\" ? \"Australian Capital Territory\" : datum.country == \"NT\" ? \"Northern Territory\" : datum.country == \"TAS\" ? \"Tasmania\" : datum.country",
          "as": "country_full"
        }
      ]
    },
    {
      // Input observations, a named dataset reference, or inline annotation data. A URL is resolved relative to the site directory.
      "data": {
        "values": [
          {
            // Geographic horizontal coordinate, passed through the projection rather than treated as an ordinary chart x value.
            "longitude": 149.129,
            // Geographic vertical coordinate, passed through the projection.
            "latitude": -35.283,
            "label": "Australia"
          }
        ]
      },
      // Choose the primitive drawn for each record. Appearance can be constant here or driven by encoding below.
      "mark": {
        "type": "text",
        "dy": 18,
        "fontWeight": "bold",
        "color": "#162B4D"
      },
      // Map data fields to visual channels. field selects a column; quantitative means magnitude, nominal means category.
      "encoding": {
        // Geographic horizontal coordinate, passed through the projection rather than treated as an ordinary chart x value.
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        // Geographic vertical coordinate, passed through the projection.
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      // Input observations, a named dataset reference, or inline annotation data. A URL is resolved relative to the site directory.
      "data": {
        "url": "data/origins.json"
      },
      // Choose the primitive drawn for each record. Appearance can be constant here or driven by encoding below.
      "mark": {
        "type": "text",
        "fontSize": 15,
        "fontWeight": "bold",
        "color": "#162B4D",
        "align": {
          "expr": "datum.country == 'USA' || datum.country == 'India' || datum.country == 'Malaysia' || datum.country == 'Singapore' ? 'right' : 'left'"
        },
        "dx": {
          "expr": "datum.country == 'USA' || datum.country == 'India' || datum.country == 'Malaysia' || datum.country == 'Singapore' ? -8 : 8"
        },
        "dy": {
          "expr": "datum.country == 'UK' ? -24 : datum.country == 'Singapore' ? 20 : datum.country == 'Malaysia' ? -10 : datum.country == 'Japan' ? -4 : -12"
        }
      },
      // Map data fields to visual channels. field selects a column; quantitative means magnitude, nominal means category.
      "encoding": {
        // Geographic horizontal coordinate, passed through the projection rather than treated as an ordinary chart x value.
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        // Geographic vertical coordinate, passed through the projection.
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "country_name",
          "type": "nominal"
        },
        // Transparency changes emphasis. It does not modify the recorded visitor or spending amount.
        "opacity": {
          // Choose a visual property based on a parameter/test, for example fade unselected markets while retaining context.
          "condition": {
            "test": "originFocus == 'All origins' || datum.country == originFocus",
            "value": 1
          },
          "value": 0.25
        }
      },
      // Apply these operations in order before drawing this view/layer. datum means the current record.
      "transform": [
        {
          // Keep records satisfying this expression; unlike opacity highlighting, filtering removes records from this view/layer.
          "filter": "originFocus == 'All origins' || datum.country == originFocus"
        },
        {
          // Compute a new field; the adjacent as key names the result. This often formats labels without changing raw values.
          "calculate": "datum.country == \"USA\" ? \"United States\" : datum.country == \"UK\" ? \"United Kingdom\" : datum.country == \"NSW\" ? \"New South Wales\" : datum.country == \"VIC\" ? \"Victoria\" : datum.country == \"QLD\" ? \"Queensland\" : datum.country == \"WA\" ? \"Western Australia\" : datum.country == \"SA\" ? \"South Australia\" : datum.country == \"ACT\" ? \"Australian Capital Territory\" : datum.country == \"NT\" ? \"Northern Territory\" : datum.country == \"TAS\" ? \"Tasmania\" : datum.country",
          "as": "country_name"
        }
      ]
    }
  ],
  // Interactive values. bind connects a parameter to an HTML control; app.js can also update the resulting signal.
  "params": [
    {
      "name": "originFocus",
      "value": "All origins"
    }
  ]
}
