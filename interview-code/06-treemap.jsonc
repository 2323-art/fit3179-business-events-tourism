// INTERVIEW COPY: 06-treemap.json
// This file uses Vega directly. stratify builds Australia -> state -> destination from id/parent. treemap with squarify computes x0,y0,x1,y1 rectangles proportional to value. Only leaves carry spending.
// Read-only study companion. The website loads specs/06-treemap.json, not this .jsonc file.
// Comments explain this exact local snapshot; regenerate/recompare after future chart edits.
{
  // Select the grammar/version: Vega-Lite is a high-level chart language; Vega gives direct control over dataflows and marks.
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 1000,
  "height": 380,
  "padding": 0,
  "autosize": "none",
  // Input observations, a named dataset reference, or inline annotation data. A URL is resolved relative to the site directory.
  "data": [
    {
      "name": "tree",
      "url": "data/regions.json",
      // Apply these operations in order before drawing this view/layer. datum means the current record.
      "transform": [
        {
          // Build a tree using id as the unique node key and parent as its parent ID.
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          // Compute rectangles; squarify favours usable aspect ratios while preserving area proportional to value.
          "type": "treemap",
          "field": "value",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "method": "squarify",
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ],
          "paddingInner": 4,
          "paddingOuter": 5,
          "paddingTop": 4
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      // Apply these operations in order before drawing this view/layer. datum means the current record.
      "transform": [
        {
          "type": "filter",
          "expr": "!datum.children"
        }
      ]
    },
    {
      "name": "parents",
      "source": "tree",
      // Apply these operations in order before drawing this view/layer. datum means the current record.
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth == 1"
        }
      ]
    },
    {
      "name": "labelled",
      "source": "leaves",
      // Apply these operations in order before drawing this view/layer. datum means the current record.
      "transform": [
        {
          "type": "formula",
          "expr": "datum.name == \"Perth region\" ? \"Perth region\" : (datum.name == \"Hobart & south\" ? \"Hobart and\\nthe South\" : (datum.name == \"ACT (all)\" ? \"Australian Capital\\nTerritory\" : (datum.name == \"Regional TAS\" ? \"Regional\\nTasmania\" : (datum.name == \"Regional NT\" ? \"Regional\\nNorthern Territory\" : (datum.name == \"Regional SA\" ? \"Regional\\nSouth Australia\" : (datum.name == \"Regional WA\" ? \"Regional\\nWestern Australia\" : (datum.name == \"Regional VIC\" ? \"Regional\\nVictoria\" : (datum.name == \"Regional QLD\" ? \"Regional\\nQueensland\" : (datum.name == \"Regional NSW\" ? \"Regional\\nNew South\\nWales\" : (datum.name))))))))))",
          "as": "label_text"
        },
        {
          "type": "formula",
          "expr": "length(split(datum.label_text, '\\n'))",
          "as": "label_lines"
        },
        {
          "type": "filter",
          "expr": "datum.y1-datum.y0 > datum.label_lines*18+8 && datum.x1-datum.x0 > max(length(split(datum.label_text,'\\n')[0]), length(split(datum.label_text,'\\n')[1] || ''), length(split(datum.label_text,'\\n')[2] || ''))*7.3+14"
        }
      ]
    },
    {
      "name": "value_labelled",
      "source": "labelled",
      // Apply these operations in order before drawing this view/layer. datum means the current record.
      "transform": [
        {
          "type": "filter",
          "expr": "datum.y1-datum.y0 > datum.label_lines*18+30 && datum.x1-datum.x0 > (width < 500 ? 64 : 92)"
        }
      ]
    }
  ],
  // Vega named scales are referenced from marks, for example stateColour maps state IDs to fill colours.
  "scales": [
    {
      "name": "stateColour",
      "type": "ordinal",
      "domain": [
        "NSW",
        "VIC",
        "QLD",
        "WA",
        "SA",
        "ACT",
        "NT",
        "TAS"
      ],
      "range": [
        "#443675",
        "#795637",
        "#748128",
        "#D2BA68",
        "#5E608B",
        "#386453",
        "#9A8468",
        "#4F7F91"
      ]
    }
  ],
  // Vega mark definitions draw the calculated hierarchy rectangles and text using named data sources.
  "marks": [
    {
      "type": "rect",
      // Choose which named Vega dataset supplies records for this mark.
      "from": {
        // Input observations, a named dataset reference, or inline annotation data. A URL is resolved relative to the site directory.
        "data": "leaves"
      },
      // Vega mark properties: enter initialises marks; update specifies properties re-evaluated as values/signals change.
      "encode": {
        "enter": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          // Second horizontal endpoint: useful for floating waterfall bars or a rule connecting two values.
          "x2": {
            "field": "x1"
          },
          // Second vertical boundary/endpoint: in the Sankey, the gap between y and y2 is ribbon thickness.
          "y2": {
            "field": "y1"
          },
          "fill": {
            // Map a data domain to a visual range. Explicit domains keep the frame stable across interactions.
            "scale": "stateColour",
            "field": "parent"
          },
          // Fields or expressions displayed on hover; formats improve readability while preserving stored values.
          "tooltip": {
            "signal": "{'Region':replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(datum.name,\"USA\",\"United States\"),\"UK\",\"United Kingdom\"),\"NSW\",\"New South Wales\"),\"VIC\",\"Victoria\"),\"QLD\",\"Queensland\"),\"WA\",\"Western Australia\"),\"SA\",\"South Australia\"),\"ACT\",\"Australian Capital Territory\"),\"NT\",\"Northern Territory\"),\"TAS\",\"Tasmania\"), 'State or territory':datum.parent == \"USA\" ? \"United States\" : datum.parent == \"UK\" ? \"United Kingdom\" : datum.parent == \"NSW\" ? \"New South Wales\" : datum.parent == \"VIC\" ? \"Victoria\" : datum.parent == \"QLD\" ? \"Queensland\" : datum.parent == \"WA\" ? \"Western Australia\" : datum.parent == \"SA\" ? \"South Australia\" : datum.parent == \"ACT\" ? \"Australian Capital Territory\" : datum.parent == \"NT\" ? \"Northern Territory\" : datum.parent == \"TAS\" ? \"Tasmania\" : datum.parent, 'Spending (Australian dollars)':format(datum.value,'$,.0f')}"
          }
        },
        "update": {
          "fillOpacity": {
            "signal": "stateFocus == 'All states' || datum.parent == stateFocus ? 1 : .18"
          }
        }
      }
    },
    {
      "type": "text",
      // Choose which named Vega dataset supplies records for this mark.
      "from": {
        // Input observations, a named dataset reference, or inline annotation data. A URL is resolved relative to the site directory.
        "data": "labelled"
      },
      // Vega mark properties: enter initialises marks; update specifies properties re-evaluated as values/signals change.
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0+4"
          },
          "y": {
            "signal": "datum.y0+19"
          },
          "text": {
            "field": "label_text"
          },
          // Transparency changes emphasis. It does not modify the recorded visitor or spending amount.
          "opacity": {
            "signal": "stateFocus == 'All states' || datum.parent == stateFocus ? 1 : 0"
          },
          "font": {
            "value": "IBM Plex Sans"
          },
          "fontSize": {
            "value": 15
          },
          "fill": {
            "signal": "indexof(['QLD','WA','NT'], datum.parent) >= 0 ? '#101820' : '#FFFFFF'"
          },
          "lineBreak": {
            "value": "\n"
          },
          "lineHeight": {
            "value": 18
          },
          "limit": {
            "signal": "datum.x1-datum.x0-8"
          }
        }
      }
    },
    {
      "type": "text",
      // Choose which named Vega dataset supplies records for this mark.
      "from": {
        // Input observations, a named dataset reference, or inline annotation data. A URL is resolved relative to the site directory.
        "data": "value_labelled"
      },
      // Vega mark properties: enter initialises marks; update specifies properties re-evaluated as values/signals change.
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0+4"
          },
          "y": {
            "signal": "datum.y0+datum.label_lines*18+23"
          },
          "text": {
            "signal": "(width < 500 ? '' : 'AUD ') + format(datum.value/1e9,'.2f') + 'bn'"
          },
          // Transparency changes emphasis. It does not modify the recorded visitor or spending amount.
          "opacity": {
            "signal": "stateFocus == 'All states' || datum.parent == stateFocus ? 1 : 0"
          },
          "font": {
            "value": "IBM Plex Sans"
          },
          "fontSize": {
            "value": 15
          },
          "fill": {
            "signal": "indexof(['QLD','WA','NT'], datum.parent) >= 0 ? '#101820' : '#FFFFFF'"
          },
          "lineBreak": {
            "value": "\n"
          },
          "lineHeight": {
            "value": 18
          },
          "limit": {
            "signal": "datum.x1-datum.x0-8"
          }
        }
      }
    }
  ],
  // Vega interactive variables. app.js updates stateFocus through view.signal(...).runAsync().
  "signals": [
    {
      "name": "stateFocus",
      "value": "All states"
    }
  ]
}
