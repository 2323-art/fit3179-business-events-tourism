// INTERVIEW COPY: 03-sankey.json
// Custom Sankey: Python prepares ribbon samples. area fills between y and y2; detail keeps links separate. rule marks draw node bars; text layers label amounts. There is no built-in sankey mark here.
// Read-only study companion. The website loads specs/03-sankey.json, not this .jsonc file.
// Comments explain this exact local snapshot; regenerate/recompare after future chart edits.
{
  "width": "container",
  "height": 380,
  // Shared presentation defaults for this chart: fonts, axes, gridlines, legends and text.
  "config": {
    "font": "IBM Plex Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "gridColor": "#DFE6EE",
      "domain": false,
      "tickColor": "#B3C2D3",
      "labelColor": "#4E6078",
      "titleColor": "#162B4D",
      "titlePadding": 14,
      "labelLimit": 150,
      "labelPadding": 7,
      "labelOverlap": true
    },
    "legend": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "orient": "bottom",
      "title": null,
      "labelLimit": 240
    },
    "title": {
      "fontSize": 16,
      "anchor": "start",
      "color": "#162B4D",
      "lineHeight": 20
    },
    "text": {
      "fontSize": 16,
      "lineHeight": 20,
      "color": "#162B4D"
    }
  },
  // Select the grammar/version: Vega-Lite is a high-level chart language; Vega gives direct control over dataflows and marks.
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  // Draw these subviews on top of each other: earlier layers form the background; later layers add marks/labels.
  "layer": [
    {
      // Input observations, a named dataset reference, or inline annotation data. A URL is resolved relative to the site directory.
      "data": {
        "url": "data/flows.json"
      },
      // Choose the primitive drawn for each record. Appearance can be constant here or driven by encoding below.
      "mark": {
        "type": "area",
        // Transparency changes emphasis. It does not modify the recorded visitor or spending amount.
        "opacity": 0.8
      },
      // Map data fields to visual channels. field selects a column; quantitative means magnitude, nominal means category.
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "axis": null,
          // Map a data domain to a visual range. Explicit domains keep the frame stable across interactions.
          "scale": {
            "domain": [
              -0.03,
              1.03
            ]
          }
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "axis": null,
          // Map a data domain to a visual range. Explicit domains keep the frame stable across interactions.
          "scale": {
            "domain": [
              23,
              0
            ]
          }
        },
        // Second vertical boundary/endpoint: in the Sankey, the gap between y and y2 is ribbon thickness.
        "y2": {
          "field": "y2"
        },
        // Group marks into separate series/links without assigning another visible colour or size.
        "detail": {
          "field": "link",
          "type": "nominal"
        },
        "color": {
          "field": "traveller",
          "type": "nominal",
          // Map a data domain to a visual range. Explicit domains keep the frame stable across interactions.
          "scale": {
            "domain": [
              "Domestic day",
              "Domestic overnight",
              "International"
            ],
            "range": [
              "#B47716",
              "#007F78",
              "#2457D6"
            ]
          },
          "legend": null
        },
        // Fields or expressions displayed on hover; formats improve readability while preserving stored values.
        "tooltip": [
          {
            "field": "link",
            "type": "nominal",
            "title": "Flow"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Australian dollars",
            // Parsing or display formatting, depending on location: reading GeoJSON features or formatting readable numbers.
            "format": "$,.0f"
          }
        ]
      }
    },
    {
      // Input observations, a named dataset reference, or inline annotation data. A URL is resolved relative to the site directory.
      "data": {
        "url": "data/flow-nodes.json"
      },
      // Choose the primitive drawn for each record. Appearance can be constant here or driven by encoding below.
      "mark": {
        "type": "rule",
        // Line thickness. When a field is mapped here, its magnitude determines the visible width.
        "strokeWidth": 7,
        "color": "#162B4D"
      },
      // Map data fields to visual channels. field selects a column; quantitative means magnitude, nominal means category.
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        // Second vertical boundary/endpoint: in the Sankey, the gap between y and y2 is ribbon thickness.
        "y2": {
          "field": "y2"
        }
      }
    },
    {
      // Input observations, a named dataset reference, or inline annotation data. A URL is resolved relative to the site directory.
      "data": {
        "url": "data/flow-nodes.json"
      },
      // Apply these operations in order before drawing this view/layer. datum means the current record.
      "transform": [
        {
          // Keep records satisfying this expression; unlike opacity highlighting, filtering removes records from this view/layer.
          "filter": "datum.x == 1"
        },
        {
          // Compute a new field; the adjacent as key names the result. This often formats labels without changing raw values.
          "calculate": "datum.label == 'Outside Australia' ? 21.6 : (datum.y + datum.y2)/2",
          "as": "mid"
        },
        {
          // Compute a new field; the adjacent as key names the result. This often formats labels without changing raw values.
          "calculate": "(datum.label == 'Outside Australia' ? 'Overseas' : datum.label) + '\\nAUD ' + format(datum.value/1e9,'.2f') + 'bn'",
          "as": "direct_label"
        }
      ],
      // Choose the primitive drawn for each record. Appearance can be constant here or driven by encoding below.
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -10,
        "color": "#07101C",
        "fontWeight": "bold",
        "fontSize": 15,
        "lineBreak": "\n",
        "lineHeight": 18,
        "baseline": "middle",
        "dy": 0
      },
      // Map data fields to visual channels. field selects a column; quantitative means magnitude, nominal means category.
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "mid",
          "type": "quantitative"
        },
        "text": {
          "field": "direct_label",
          "type": "nominal"
        }
      }
    },
    {
      // Input observations, a named dataset reference, or inline annotation data. A URL is resolved relative to the site directory.
      "data": {
        "url": "data/flow-nodes.json"
      },
      // Apply these operations in order before drawing this view/layer. datum means the current record.
      "transform": [
        {
          // Keep records satisfying this expression; unlike opacity highlighting, filtering removes records from this view/layer.
          "filter": "datum.x == 0"
        },
        {
          // Compute a new field; the adjacent as key names the result. This often formats labels without changing raw values.
          "calculate": "(datum.y + datum.y2)/2",
          "as": "mid"
        },
        {
          // Compute a new field; the adjacent as key names the result. This often formats labels without changing raw values.
          "calculate": "(datum.label == 'Domestic overnight' ? 'Domestic\\novernight' : datum.label) + '\\nAUD ' + format(datum.value/1e9,'.2f') + 'bn'",
          "as": "direct_label"
        }
      ],
      // Choose the primitive drawn for each record. Appearance can be constant here or driven by encoding below.
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "color": "#07101C",
        "fontWeight": "bold",
        "fontSize": 15,
        "lineBreak": "\n",
        "lineHeight": 18,
        "baseline": "middle",
        "dy": -5
      },
      // Map data fields to visual channels. field selects a column; quantitative means magnitude, nominal means category.
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "mid",
          "type": "quantitative"
        },
        "text": {
          "field": "direct_label",
          "type": "nominal"
        }
      }
    },
    {
      // Input observations, a named dataset reference, or inline annotation data. A URL is resolved relative to the site directory.
      "data": {
        "values": [
          {
            "x": 0.98,
            "y": 16.1,
            "label": "AUD 2.34bn"
          }
        ]
      },
      // Choose the primitive drawn for each record. Appearance can be constant here or driven by encoding below.
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -10,
        "fontWeight": "bold",
        "fontSize": 15,
        "color": "#07101C"
      },
      // Map data fields to visual channels. field selects a column; quantitative means magnitude, nominal means category.
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      // Input observations, a named dataset reference, or inline annotation data. A URL is resolved relative to the site directory.
      "data": {
        "values": [
          {
            "x": 1,
            "y": 19.92,
            "end": 20.5
          }
        ]
      },
      // Choose the primitive drawn for each record. Appearance can be constant here or driven by encoding below.
      "mark": {
        "type": "rule",
        "color": "#162B4D"
      },
      // Map data fields to visual channels. field selects a column; quantitative means magnitude, nominal means category.
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        // Second vertical boundary/endpoint: in the Sankey, the gap between y and y2 is ribbon thickness.
        "y2": {
          "field": "end"
        }
      }
    }
  ]
}
