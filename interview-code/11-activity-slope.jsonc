// INTERVIEW COPY: 11-activity-slope.json
// Filter out shopping to show four activities. Prepared shares determine vertical position; two horizontal positions represent the years. detail groups the two records per activity into a line; colour and dash identify it.
// Read-only study companion. The website loads specs/11-activity-slope.json, not this .jsonc file.
// Comments explain this exact local snapshot; regenerate/recompare after future chart edits.
{
  "width": "container",
  "height": 320,
  // Shared presentation defaults for this chart: fonts, axes, gridlines, legends and text.
  "config": {
    "font": "IBM Plex Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "gridColor": "#DFE6EE",
      "domain": false,
      "tickColor": "#B3C2D3",
      "labelColor": "#4E6078",
      "titleColor": "#162B4D",
      "titlePadding": 14,
      "labelLimit": 150,
      "labelPadding": 7,
      "labelOverlap": true
    },
    "legend": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "orient": "bottom",
      "title": null,
      "labelLimit": 240
    },
    "title": {
      "fontSize": 16,
      "anchor": "start",
      "color": "#162B4D",
      "lineHeight": 20
    },
    "text": {
      "fontSize": 16,
      "lineHeight": 20,
      "color": "#162B4D"
    }
  },
  // Select the grammar/version: Vega-Lite is a high-level chart language; Vega gives direct control over dataflows and marks.
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  // Input observations, a named dataset reference, or inline annotation data. A URL is resolved relative to the site directory.
  "data": {
    "url": "data/activities.json"
  },
  // Apply these operations in order before drawing this view/layer. datum means the current record.
  "transform": [
    {
      // Keep records satisfying this expression; unlike opacity highlighting, filtering removes records from this view/layer.
      "filter": "datum.activity != 'Go shopping'"
    },
    {
      // Compute a new field; the adjacent as key names the result. This often formats labels without changing raw values.
      "calculate": "datum.year == 2024 ? 0.06 : 0.55",
      "as": "position"
    }
  ],
  // Map data fields to visual channels. field selects a column; quantitative means magnitude, nominal means category.
  "encoding": {
    "x": {
      "field": "position",
      "type": "quantitative",
      "axis": null,
      // Map a data domain to a visual range. Explicit domains keep the frame stable across interactions.
      "scale": {
        "domain": [
          0,
          1
        ],
        "nice": false
      }
    },
    "y": {
      "field": "share",
      "type": "quantitative",
      "axis": null,
      // Map a data domain to a visual range. Explicit domains keep the frame stable across interactions.
      "scale": {
        "domain": [
          0.12,
          1.08
        ],
        "nice": false
      }
    }
  },
  // Draw these subviews on top of each other: earlier layers form the background; later layers add marks/labels.
  "layer": [
    {
      // Choose the primitive drawn for each record. Appearance can be constant here or driven by encoding below.
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 55
        },
        // Line thickness. When a field is mapped here, its magnitude determines the visible width.
        "strokeWidth": 2
      },
      // Map data fields to visual channels. field selects a column; quantitative means magnitude, nominal means category.
      "encoding": {
        // Group marks into separate series/links without assigning another visible colour or size.
        "detail": {
          "field": "activity",
          "type": "nominal"
        },
        "color": {
          "field": "activity",
          "type": "nominal",
          // Map a data domain to a visual range. Explicit domains keep the frame stable across interactions.
          "scale": {
            "domain": [
              "Dine out",
              "Sightseeing",
              "Go to the beach",
              "National/state parks"
            ],
            "range": [
              "#008B9C",
              "#6E3D60",
              "#526F24",
              "#3F667B"
            ]
          },
          "legend": null
        },
        // Dash pattern gives a category cue in addition to colour, particularly for activity lines.
        "strokeDash": {
          "field": "activity",
          "type": "nominal",
          // Map a data domain to a visual range. Explicit domains keep the frame stable across interactions.
          "scale": {
            "domain": [
              "Dine out",
              "Sightseeing",
              "Go to the beach",
              "National/state parks"
            ],
            "range": [
              [],
              [
                8,
                4
              ],
              [
                3,
                3
              ],
              [
                10,
                3,
                2,
                3
              ]
            ]
          },
          "legend": null
        },
        // Fields or expressions displayed on hover; formats improve readability while preserving stored values.
        "tooltip": [
          {
            "field": "activity_full",
            "type": "nominal"
          },
          {
            "field": "year",
            "type": "ordinal"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Participation",
            // Parsing or display formatting, depending on location: reading GeoJSON features or formatting readable numbers.
            "format": ".1%"
          }
        ]
      },
      // Apply these operations in order before drawing this view/layer. datum means the current record.
      "transform": [
        {
          // Compute a new field; the adjacent as key names the result. This often formats labels without changing raw values.
          "calculate": "datum.activity == 'National/state parks' ? 'National and state parks' : datum.activity",
          "as": "activity_full"
        }
      ]
    },
    {
      // Choose the primitive drawn for each record. Appearance can be constant here or driven by encoding below.
      "mark": {
        "type": "text",
        "dy": -22,
        "fontSize": 15,
        "color": "#162B4D"
      },
      // Map data fields to visual channels. field selects a column; quantitative means magnitude, nominal means category.
      "encoding": {
        "text": {
          "field": "share",
          "type": "quantitative",
          // Parsing or display formatting, depending on location: reading GeoJSON features or formatting readable numbers.
          "format": ".1%"
        },
        // Group marks into separate series/links without assigning another visible colour or size.
        "detail": {
          "field": "activity",
          "type": "nominal"
        }
      },
      // Apply these operations in order before drawing this view/layer. datum means the current record.
      "transform": [
        {
          // Keep records satisfying this expression; unlike opacity highlighting, filtering removes records from this view/layer.
          "filter": "datum.activity == 'Sightseeing'"
        }
      ]
    },
    {
      // Input observations, a named dataset reference, or inline annotation data. A URL is resolved relative to the site directory.
      "data": {
        "values": [
          {
            "position": 0.06,
            "share": 1.065,
            "year": "2024"
          },
          {
            "position": 0.55,
            "share": 1.065,
            "year": "2025"
          }
        ]
      },
      // Choose the primitive drawn for each record. Appearance can be constant here or driven by encoding below.
      "mark": {
        "type": "text",
        "fontSize": 15,
        "fontWeight": "bold",
        "color": "#162B4D"
      },
      // Map data fields to visual channels. field selects a column; quantitative means magnitude, nominal means category.
      "encoding": {
        "text": {
          "field": "year",
          "type": "nominal"
        }
      }
    },
    {
      // Apply these operations in order before drawing this view/layer. datum means the current record.
      "transform": [
        {
          // Keep records satisfying this expression; unlike opacity highlighting, filtering removes records from this view/layer.
          "filter": "datum.year == 2025"
        },
        {
          // Compute a new field; the adjacent as key names the result. This often formats labels without changing raw values.
          "calculate": "datum.activity == 'National/state parks' ? 'National and\\nstate parks' : datum.activity == 'Go to the beach' ? 'Go to the\\nbeach' : datum.activity",
          "as": "direct_name"
        }
      ],
      // Choose the primitive drawn for each record. Appearance can be constant here or driven by encoding below.
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 15,
        "lineBreak": "\n",
        "lineHeight": 17,
        "color": "#162B4D"
      },
      // Map data fields to visual channels. field selects a column; quantitative means magnitude, nominal means category.
      "encoding": {
        "text": {
          "field": "direct_name"
        }
      }
    }
  ]
}
