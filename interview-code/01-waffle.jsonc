// INTERVIEW COPY: 01-waffle.json
// Paired 100-cell grids: prepared x/y cells become rectangles; colour identifies traveller type. hconcat places the two metrics side by side. Whole-cell rounding happens in build_data.py.
// Read-only study companion. The website loads specs/01-waffle.json, not this .jsonc file.
// Comments explain this exact local snapshot; regenerate/recompare after future chart edits.
{
  "width": "container",
  "height": 180,
  // Shared presentation defaults for this chart: fonts, axes, gridlines, legends and text.
  "config": {
    "font": "IBM Plex Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "gridColor": "#DFE6EE",
      "domain": false,
      "tickColor": "#B3C2D3",
      "labelColor": "#4E6078",
      "titleColor": "#162B4D",
      "titlePadding": 14,
      "labelLimit": 150,
      "labelPadding": 7,
      "labelOverlap": true
    },
    "legend": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "orient": "bottom",
      "title": null,
      "labelLimit": 240
    },
    "title": {
      "fontSize": 16,
      "anchor": "start",
      "color": "#162B4D",
      "lineHeight": 20
    },
    "text": {
      "fontSize": 16,
      "lineHeight": 20,
      "color": "#162B4D"
    }
  },
  // Select the grammar/version: Vega-Lite is a high-level chart language; Vega gives direct control over dataflows and marks.
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  // Place these views beside each other. The waffle pair is one figure with two component grids.
  "hconcat": [
    {
      "width": 180,
      "height": 180,
      "title": "Visitor trips",
      // Input observations, a named dataset reference, or inline annotation data. A URL is resolved relative to the site directory.
      "data": {
        "url": "data/waffle.json"
      },
      // Apply these operations in order before drawing this view/layer. datum means the current record.
      "transform": [
        {
          // Keep records satisfying this expression; unlike opacity highlighting, filtering removes records from this view/layer.
          "filter": "datum.metric === \"Visitor trips\""
        }
      ],
      // Choose the primitive drawn for each record. Appearance can be constant here or driven by encoding below.
      "mark": {
        "type": "rect",
        "cornerRadius": 2,
        "stroke": "white",
        // Line thickness. When a field is mapped here, its magnitude determines the visible width.
        "strokeWidth": 2
      },
      // Map data fields to visual channels. field selects a column; quantitative means magnitude, nominal means category.
      "encoding": {
        "x": {
          "field": "x",
          "type": "ordinal",
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "ordinal",
          "axis": null
        },
        "color": {
          "field": "traveller",
          "type": "nominal",
          // Map a data domain to a visual range. Explicit domains keep the frame stable across interactions.
          "scale": {
            "domain": [
              "Domestic day",
              "Domestic overnight",
              "International"
            ],
            "range": [
              "#B47716",
              "#007F78",
              "#2457D6"
            ]
          },
          "legend": null
        },
        // Fields or expressions displayed on hover; formats improve readability while preserving stored values.
        "tooltip": [
          {
            "field": "traveller",
            "type": "nominal",
            "title": "Traveller"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Exact share",
            // Parsing or display formatting, depending on location: reading GeoJSON features or formatting readable numbers.
            "format": ".1%"
          }
        ]
      }
    },
    {
      "width": 180,
      "height": 180,
      "title": [
        "Spending in",
        "Australia"
      ],
      // Input observations, a named dataset reference, or inline annotation data. A URL is resolved relative to the site directory.
      "data": {
        "url": "data/waffle.json"
      },
      // Apply these operations in order before drawing this view/layer. datum means the current record.
      "transform": [
        {
          // Keep records satisfying this expression; unlike opacity highlighting, filtering removes records from this view/layer.
          "filter": "datum.metric === \"Spending in Australia\""
        }
      ],
      // Choose the primitive drawn for each record. Appearance can be constant here or driven by encoding below.
      "mark": {
        "type": "rect",
        "cornerRadius": 2,
        "stroke": "white",
        // Line thickness. When a field is mapped here, its magnitude determines the visible width.
        "strokeWidth": 2
      },
      // Map data fields to visual channels. field selects a column; quantitative means magnitude, nominal means category.
      "encoding": {
        "x": {
          "field": "x",
          "type": "ordinal",
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "ordinal",
          "axis": null
        },
        "color": {
          "field": "traveller",
          "type": "nominal",
          // Map a data domain to a visual range. Explicit domains keep the frame stable across interactions.
          "scale": {
            "domain": [
              "Domestic day",
              "Domestic overnight",
              "International"
            ],
            "range": [
              "#B47716",
              "#007F78",
              "#2457D6"
            ]
          },
          "legend": null
        },
        // Fields or expressions displayed on hover; formats improve readability while preserving stored values.
        "tooltip": [
          {
            "field": "traveller",
            "type": "nominal",
            "title": "Traveller"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Exact share",
            // Parsing or display formatting, depending on location: reading GeoJSON features or formatting readable numbers.
            "format": ".1%"
          }
        ]
      }
    }
  ],
  "spacing": 28,
  "resolve": {
    // Map a data domain to a visual range. Explicit domains keep the frame stable across interactions.
    "scale": {
      "color": "shared"
    }
  }
}
