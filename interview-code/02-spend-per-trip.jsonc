// INTERVIEW COPY: 02-spend-per-trip.json
// 2025 records only. Bar length represents prepared spend_per_trip on a zero-based scale; a separate text layer provides values.
// Read-only study companion. The website loads specs/02-spend-per-trip.json, not this .jsonc file.
// Comments explain this exact local snapshot; regenerate/recompare after future chart edits.
{
  "width": "container",
  "height": 300,
  // Shared presentation defaults for this chart: fonts, axes, gridlines, legends and text.
  "config": {
    "font": "IBM Plex Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "gridColor": "#DFE6EE",
      "domain": false,
      "tickColor": "#B3C2D3",
      "labelColor": "#4E6078",
      "titleColor": "#162B4D",
      "titlePadding": 14,
      "labelLimit": 150,
      "tickCount": 5,
      "labelPadding": 7,
      "labelOverlap": true
    },
    "legend": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "orient": "bottom",
      "title": null,
      "labelLimit": 240
    },
    "title": {
      "fontSize": 16,
      "anchor": "start",
      "color": "#162B4D",
      "lineHeight": 20
    },
    "text": {
      "fontSize": 16,
      "lineHeight": 20,
      "color": "#162B4D"
    }
  },
  // Select the grammar/version: Vega-Lite is a high-level chart language; Vega gives direct control over dataflows and marks.
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  // Input observations, a named dataset reference, or inline annotation data. A URL is resolved relative to the site directory.
  "data": {
    "url": "data/national.json"
  },
  // Apply these operations in order before drawing this view/layer. datum means the current record.
  "transform": [
    {
      // Keep records satisfying this expression; unlike opacity highlighting, filtering removes records from this view/layer.
      "filter": "datum.year == 2025"
    }
  ],
  // Draw these subviews on top of each other: earlier layers form the background; later layers add marks/labels.
  "layer": [
    {
      // Choose the primitive drawn for each record. Appearance can be constant here or driven by encoding below.
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3
      },
      // Map data fields to visual channels. field selects a column; quantitative means magnitude, nominal means category.
      "encoding": {
        "x": {
          "field": "spend_per_trip",
          "type": "quantitative",
          "title": [
            "Spending per trip",
            "in AUD"
          ],
          "axis": {
            // Parsing or display formatting, depending on location: reading GeoJSON features or formatting readable numbers.
            "format": "$,.0f",
            "tickCount": 3
          },
          // Map a data domain to a visual range. Explicit domains keep the frame stable across interactions.
          "scale": {
            "domain": [
              0,
              3800
            ]
          }
        },
        "y": {
          "field": "traveller",
          "type": "nominal",
          "sort": [
            "International",
            "Domestic overnight",
            "Domestic day"
          ],
          "title": null,
          "axis": {
            "labelExpr": "datum.label == 'Domestic overnight' ? ['Domestic', 'overnight'] : datum.label",
            "labelLineHeight": 18
          }
        },
        "color": {
          "field": "traveller",
          "type": "nominal",
          // Map a data domain to a visual range. Explicit domains keep the frame stable across interactions.
          "scale": {
            "domain": [
              "Domestic day",
              "Domestic overnight",
              "International"
            ],
            "range": [
              "#B47716",
              "#007F78",
              "#2457D6"
            ]
          },
          "legend": null
        },
        // Fields or expressions displayed on hover; formats improve readability while preserving stored values.
        "tooltip": [
          {
            "field": "traveller",
            "type": "nominal"
          },
          {
            "field": "spend_per_trip",
            "type": "quantitative",
            "title": "AUD per trip",
            // Parsing or display formatting, depending on location: reading GeoJSON features or formatting readable numbers.
            "format": "$,.0f"
          }
        ]
      }
    }
  ]
}
